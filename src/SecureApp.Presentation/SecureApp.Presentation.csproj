<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>SecureApp.Presentation</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>SecureApp.Presentation</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.secureapp.presentation</ApplicationId>

		<!-- Versions — ApplicationVersion is the Android versionCode; bump it on every release build
		     that should be offered as an update (the self-update system, 2026-09-23, compares this
		     number, not ApplicationDisplayVersion, to decide "is there something newer"). -->
		<ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<!-- 2026-09-16, real live bug: opening the on-screen keyboard in a chat's compose box pushed
		     the whole page up and out of reach on a real Android 16 device (S23+). Root cause: the
		     .NET Android workload resolves net10.0-android's targetSdkVersion to 36, and Android
		     mandates edge-to-edge rendering once targetSdkVersion >= 35 — MainActivity's own
		     WindowSoftInputMode="AdjustResize" alone isn't enough under edge-to-edge without the app
		     also consuming WindowInsets itself, confirmed live. Tried pinning AndroidTargetSdkVersion
		     down first (the "obvious" fix) — doesn't work in this SDK release: `AndroidTargetSdkVersion`
		     isn't actually read as an input anywhere in Microsoft.Android.Sdk.Windows's own .targets
		     (confirmed by inspecting them directly; only an internal `_AndroidTargetSdkVersion` OUTPUT
		     exists, always resolving to the latest installed platform regardless of what's set here or
		     on the command line, even with an older platform SDK installed alongside it). Fixed instead
		     in code — see MainActivity.OnCreate's own remarks — which works regardless of targetSdk. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Pin an explicit RID + force the native apphost for the Windows/WinUI head.
		     Without this, some VS versions launch the app via a generic "dotnet.exe exec"
		     host instead of the native apphost .exe. Windows App SDK's unpackaged bootstrap
		     resolves its native DLLs relative to the *hosting* process, so under dotnet.exe
		     (which lives in Program Files\dotnet, with no WindowsAppRuntime DLLs beside it)
		     the bootstrap fails immediately and silently, before any managed exception can
		     be raised or logged. Launching the real apphost avoids this entirely. -->
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
		<UseAppHost Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</UseAppHost>
		<SelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</SelfContained>

		<!-- Belt-and-suspenders: the RID pin above wasn't enough to stop this VS build from
		     resolving the debug launch via "dotnet.exe exec" instead of the apphost, so
		     force the exact executable VS/MSBuild's CPS debug launcher reads (RunCommand)
		     directly. This is what Ctrl+F5/F5 actually invoke, bypassing whatever picked
		     dotnet.exe before. Confirmed via CLI: dotnet.exe exec on the .dll crashes with
		     native exit code -1073741189; the apphost .exe below runs fine. -->
		<RunCommand Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(TargetDir)$(TargetName)$(TargetExt)</RunCommand>
		<RunWorkingDirectory Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(TargetDir)</RunWorkingDirectory>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="HarfBuzzSharp" Version="14.2.1.2" />
		<PackageReference Include="PDFtoImage" Version="5.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.1" />
		<PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.24" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SecureApp.Domain\SecureApp.Domain.csproj" />
	  <ProjectReference Include="..\SecureApp.Data\SecureApp.Data.csproj" />
	</ItemGroup>

	<!-- Android release signing (2026-09-23) — see keystore/README.md for the full story. The props
	     file itself is git-ignored (keystore/ is excluded wholesale) so the real password never
	     reaches git; this Import is the only trace of it in tracked source. -->
	<Import Project="..\..\keystore\signing.local.props" Condition="Exists('..\..\keystore\signing.local.props')" />

</Project>
