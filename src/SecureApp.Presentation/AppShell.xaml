<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SecureApp.Presentation.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SecureApp.Presentation.Views"
    Title="SecureApp">

    <!-- Four top-level sections as real tabs, replacing the old single ShellContent +
         corner-button navigation (💬📚⚙ buttons on DocumentBrowserPage). Detail/pushed pages
         (DocumentViewerPage, NewChatPage, ChatPage) are NOT tabs — they're reached via
         GoToAsync and registered below via Routing.RegisterRoute instead. -->
    <!-- Chats leads — the user's own call (2026-09-06): discussing a procedure is the actual
         day-to-day activity, Documents (private per-device files) is used far less often.
         Tab labels translated to Czech 2026-09-06 (user's own ask: "preved to do cestiny"). -->
    <TabBar>
        <Tab Title="💬 Chaty">
            <ShellContent ContentTemplate="{DataTemplate views:ChatListPage}" Route="ChatListTab" />
        </Tab>
        <Tab Title="📚 Knihovna">
            <ShellContent ContentTemplate="{DataTemplate views:LibraryPage}" Route="LibraryTab" />
        </Tab>
        <Tab Title="🗂 Dokumenty">
            <ShellContent ContentTemplate="{DataTemplate views:DocumentBrowserPage}" Route="DocumentBrowser" />
        </Tab>
        <!-- Kontakty (2026-09-10) — telefonní seznam + rychlé kontakty, user's own ask for its own
             standalone menu, separate from Logbook. Always visible (no Settings toggle the way
             Logbook has) — it's a single lightweight read-only reference page, not a whole
             subsystem with RBAC/admin forms, so tab-crowding isn't the same concern here. Inserted
             BEFORE Nastavení, same "keep Settings last" convention as Logbook's own insertion in
             AppShell.xaml.cs (which now targets one index further right to still land before it). -->
        <Tab Title="☎ Kontakty">
            <ShellContent ContentTemplate="{DataTemplate views:ContactsPage}" Route="ContactsTab" />
        </Tab>
        <Tab Title="⚙ Nastavení">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsTab" />
        </Tab>
    </TabBar>

</Shell>
