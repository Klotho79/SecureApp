<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SecureApp.Presentation.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SecureApp.Presentation.Views"
    Title="SecureApp">

    <!-- Four top-level sections as real tabs, replacing the old single ShellContent +
         corner-button navigation (💬📚⚙ buttons on DocumentBrowserPage). Detail/pushed pages
         (DocumentViewerPage, NewChatPage, ChatPage) are NOT tabs — they're reached via
         GoToAsync and registered below via Routing.RegisterRoute instead. -->
    <!-- Chats leads — the user's own call (2026-09-06): discussing a procedure is the actual
         day-to-day activity, Documents (private per-device files) is used far less often.
         Tab labels translated to Czech 2026-09-06 (user's own ask: "preved to do cestiny"). -->
    <!-- x:Name'd on every tab except Nastavení (2026-09-16, user's own ask: "chci mít možnost
         schovávat jednotlivé menu kromě settings") — AppShell.xaml.cs's RebuildTabBar reads these
         by reference to insert/remove them from the live TabBar per a per-device Settings toggle,
         the same mechanism Logbook's own show/hide already used, now generalized to every tab. -->
    <TabBar>
        <!-- Notification Hub (2026-09-20, see NOTIFICATION_HUB_SPEC.md) — leads the TabBar as the
             app's new "personal work information center" home, ahead of Chaty. Labeled "Nástěnka"
             (2026-09-20, user's own rename) rather than "Oznámení" — the tab/board itself is the
             nástěnka, individual rows on it stay called "oznámení" (see NotificationDetailPage's
             own title). -->
        <Tab x:Name="NotificationsTab" Title="📌 Nástěnka">
            <ShellContent ContentTemplate="{DataTemplate views:NotificationsPage}" Route="NotificationsTab" />
        </Tab>
        <Tab x:Name="ChatsTab" Title="💬 Chaty">
            <ShellContent ContentTemplate="{DataTemplate views:ChatListPage}" Route="ChatListTab" />
        </Tab>
        <!-- Knihovna + Dokumenty merged under one bottom-tab item (2026-09-16, user's own ask: two
             menu-crowding tabs for two related "browse files" screens — with this many tabs already,
             Nastavení was getting pushed into Android's "More" overflow). Storage/data stayed
             untouched (still two separate pages/ViewModels/pipelines, local per-device Documents vs.
             the shared relay-hosted Library) — only the NAVIGATION merged: Shell natively renders
             multiple ShellContent children of one Tab as a top sub-tab strip, so this needed no new
             page/switcher of its own. -->
        <Tab x:Name="FilesTab" Title="🗂 Soubory">
            <ShellContent Title="Knihovna" ContentTemplate="{DataTemplate views:LibraryPage}" Route="LibraryTab" />
            <ShellContent Title="Dokumenty" ContentTemplate="{DataTemplate views:DocumentBrowserPage}" Route="DocumentBrowser" />
        </Tab>
        <!-- Kontakty (2026-09-10) — telefonní seznam + rychlé kontakty, user's own ask for its own
             standalone menu, separate from Logbook. Inserted BEFORE Nastavení, same "keep Settings
             last" convention as Logbook's own insertion in AppShell.xaml.cs. -->
        <Tab x:Name="ContactsTab" Title="☎ Kontakty">
            <ShellContent ContentTemplate="{DataTemplate views:ContactsPage}" Route="ContactsTab" />
        </Tab>
        <!-- Redakce (2026-10-13, user's own ask: "vsechny modifikace upravy a vkladani zprav... dej
             do nastenky jako jednu polozku na spodnim menu") — one consolidated tab for every
             edit/post action that used to be scattered (board composer was in Nastavení→Uživatel→
             Nástěnka, sál-status-options management was inline on Nástěnka itself). Editing the
             device's OWN sál status stays inline on Nástěnka (user's own explicit call) — only the
             Admin/Modifier-only actions moved here. Inserted BEFORE Nastavení, same convention as
             Kontakty's own insertion above. -->
        <Tab x:Name="RedakceTab" Title="📝 Redakce">
            <ShellContent ContentTemplate="{DataTemplate views:RedakcePage}" Route="RedakceTab" />
        </Tab>
        <Tab Title="⚙ Nastavení">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsTab" />
        </Tab>
    </TabBar>

</Shell>
