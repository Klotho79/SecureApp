<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:NotificationsViewModel"
    Title="Nástěnka"
    Shell.NavBarIsVisible="False">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Nástěnka" Style="{StaticResource PageTitle}" />
                <Button Grid.Column="1" Text="🔍" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Clicked="OnSearchClicked" />
                <Button Grid.Column="2" Text="⚙" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Clicked="OnSettingsClicked" />
            </Grid>

            <!-- 2026-10-13, user's own ask: replace the Důležité/Nepřečtené/Dnes counter cards with
                 direct navigation — those two chips still filter the message list below unchanged,
                 this row is for jumping to the 3 related screens instead. "Rozpis" subsumes the old
                 small 📅 header button (same WorkplacePage target, now a bigger/clearer entry point).
                 "Akutní stavy" opens Knihovna (its quick-access row lives there, see LibraryPage.xaml's
                 own "Akutní stavy" section) rather than being a separate screen. -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="📅 Rozpis" Style="{StaticResource SecondaryButton}" FontSize="10.5" Clicked="OnWorkplaceClicked" />
                <Button Grid.Column="1" Text="🚨 Akutní stavy" Style="{StaticResource SecondaryButton}" FontSize="10.5" Clicked="OnAcuteStatesClicked" />
                <Button Grid.Column="2" Text="☎ Kontakty" Style="{StaticResource SecondaryButton}" FontSize="10.5" Clicked="OnContactsClicked" />
            </Grid>

            <!-- Status (2026-10-14, user's own ask) — opens the full "Stav sálů" board
                 (kompletní obsazení salů se statusy a poznamkami, see RoomStatusPage) via the "Vše ›"
                 button inside the picker dialog below. Always shown (2026-10-16: no longer gated on
                 today's rozpis — see NotificationsViewModel.RoomStatus.cs's own remarks for the
                 "nezařazen" placeholder shown when today's own rozpis has no qualifying sál).
                 2026-10-15 design pass ("strasne osklive" → Design-canvas mockup, matched against the
                 app's own already-chosen visual direction): the Picker dropdown is gone — a small badge
                 shows the current status at a glance, and a color-coded grid of tiles below lets the
                 user change it with one tap (no separate confirm button). Header/nav buttons around it
                 are intentionally untouched, per the user's own ask. -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CanSeeRoomStatus}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="🏥 Stav mého sálu" Style="{StaticResource SectionHeader}" Margin="0" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Vše ›" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="12,0" MinimumHeightRequest="32" MinimumWidthRequest="0" Clicked="OnRoomStatusClicked" />
                    </Grid>

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding MyRoomStatusRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MyRoomStatusItem">
                                <!-- Compact row only — name + current-status badge. Tap opens the full
                                     tile-grid picker as a page-level overlay dialog (see the Grid at the
                                     end of this page), so this card stays small on the dashboard.
                                     When HasAssignment is false (no qualifying sál today), the name is
                                     hidden and only the "Nezařazen na sále" badge shows.
                                     BackgroundColor="Transparent" (2026-10-22 bugfix) — without an
                                     explicit background a Grid's own GestureRecognizers only fire where
                                     an opaque child actually covers the hit point, so only the status
                                     badge itself (not the row's empty space) was reacting to taps. -->
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=ToggleRoomStatusPickerCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="{Binding WorkplaceName}" FontSize="12.5" FontAttributes="Bold" VerticalOptions="Center" IsVisible="{Binding HasAssignment}" />

                                    <!-- Current-status badge — color-coded, same tokens as the picker dialog's tiles. -->
                                    <Border Grid.Column="1" Padding="10,5" StrokeThickness="0" StrokeShape="RoundRectangle 999" HorizontalOptions="End"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                                            IsVisible="{Binding HasCurrentStatus}">
                                        <HorizontalStackLayout Spacing="6">
                                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center"
                                                     Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray400}}" x:Name="BadgeDot" />
                                            <Label Text="{Binding CurrentStatus}" FontSize="10.5" FontAttributes="Bold" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" x:Name="BadgeLabel" />
                                        </HorizontalStackLayout>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding CurrentCategory}" Value="Success">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding CurrentCategory}" Value="Info">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding CurrentCategory}" Value="Warn">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource WarnSoftDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding CurrentCategory}" Value="Danger">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <!-- Curated note from the full board (set by Modifier/Admin). -->
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NoteText}" FontSize="11" LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                           IsVisible="{Binding HasNote}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Opicentrum roster/volno board (2026-10-21, user's own ask for "tesnejsi pristup k
                 opicentru") — Admin/Modifier only, see NotificationsViewModel.OpicentrumBoard.cs's
                 own remarks on why this one isn't shown to a plain Viewer at all (unlike Stav sálů
                 above, which everyone sees). 2026-10-25 (user's ask): the whole card is the button, with the
                 Opicentrum ARO logo instead of the emoji and no separate "Otevřít" button. -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CanSeeOpicentrumBoard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpicentrumBoardClicked" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="opicentrum_aro.jpg" HeightRequest="32" WidthRequest="28" Aspect="AspectFit" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Rozpis pracovišť (Opicentrum)" Style="{StaticResource SectionHeader}" Margin="0" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="›" FontSize="18" TextColor="Gray" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Filter chips (spec §12) — horizontally scrollable pill row. -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding FilterChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationFilterChip">
                            <Border Style="{StaticResource Chip}" Margin="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Label}" Style="{StaticResource ChipLabel}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Chat quick access (2026-09-20) — only under the "Chat" chip (spec: "chaty ve
                 kterych uzivatel participuje s moznosti je otevrit a psat zpravy"). A live list of
                 the user's own chats/groups to jump into, not a notification history. -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsChatFilterActive}">
                <Label Text="Vaše chaty" Style="{StaticResource SectionHeader}" Margin="0,4,0,0" />
                <Label Text="Zatím žádné chaty." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoChatQuickAccess}" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding ChatQuickAccess}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatQuickAccessItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="{Binding Glyph}" FontSize="13" VerticalOptions="Center" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" />
            <Label Text="Žádná oznámení." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoNotifications}" HorizontalOptions="Center" Margin="0,20" />

            <!-- Grouped, collapsible sections (spec §5, §16). -->
            <CollectionView ItemsSource="{Binding Sections}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationSectionGroup">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding Name, StringFormat='{0} ▾'}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Text" Value="{Binding Name, StringFormat='{0} ▸'}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="1" Text="{Binding Count}" FontSize="9.5" TextColor="Gray" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding VisibleEntries}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NotificationListItem">
                                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <!-- Left priority-color accent bar — thickness-only Border trick (no separate Rectangle
                                                 needed): a 4px-wide zero-height-content Border pinned to the grid's first column. -->
                                            <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                                                <BoxView Grid.Column="0" CornerRadius="2">
                                                    <BoxView.Triggers>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding PriorityText}" Value="Critical">
                                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding PriorityText}" Value="Important">
                                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding PriorityText}" Value="Normal">
                                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource InfoDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding PriorityText}" Value="Informational">
                                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                                                        </DataTrigger>
                                                    </BoxView.Triggers>
                                                </BoxView>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Grid.Column="0" Text="{Binding Title}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                        <Label Grid.Column="1" Text="{Binding TimeText}" FontSize="9" TextColor="Gray" VerticalOptions="Center" />
                                                    </Grid>
                                                    <Label Text="{Binding Preview}" FontSize="10" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

    <!-- Room-status picker dialog (2026-10-16) — full-screen dim backdrop + centered card, shown
         while ActiveRoomStatusPicker is set. Closed only via its own "✕" (no backdrop-tap-to-close,
         to avoid MAUI gesture-bubbling edge cases with the tiles underneath).
         2026-10-16 follow-up: "Vše ›" (full board) moved in here from the dashboard card header, so
         it's reachable even when the card itself only has the unassigned placeholder to show. -->
    <Grid BackgroundColor="#80000000" IsVisible="{Binding HasActiveRoomStatusPicker}">
        <Border Style="{StaticResource CardBorder}" Margin="24" VerticalOptions="Center" Padding="16">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{Binding ActiveRoomStatusPicker.WorkplaceName}" Style="{StaticResource SectionHeader}" Margin="0" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Vše ›" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="12,0" MinimumHeightRequest="32" MinimumWidthRequest="0" Clicked="OnRoomStatusClicked" />
                    <Button Grid.Column="2" Text="✕" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0" MinimumHeightRequest="32" MinimumWidthRequest="0"
                            Command="{Binding CloseRoomStatusPickerCommand}" />
                </Grid>

                <Border Padding="10,5" StrokeThickness="0" StrokeShape="RoundRectangle 999" HorizontalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                        IsVisible="{Binding ActiveRoomStatusPicker.HasCurrentStatus}">
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center"
                                 Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray400}}" />
                        <Label Text="{Binding ActiveRoomStatusPicker.CurrentStatus}" FontSize="10.5" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </HorizontalStackLayout>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveRoomStatusPicker.CurrentCategory}" Value="Success">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveRoomStatusPicker.CurrentCategory}" Value="Info">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveRoomStatusPicker.CurrentCategory}" Value="Warn">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource WarnSoftDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveRoomStatusPicker.CurrentCategory}" Value="Danger">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <Label Text="{Binding ActiveRoomStatusPicker.NoteText}" FontSize="11.5" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       IsVisible="{Binding ActiveRoomStatusPicker.HasNote}" />

                <!-- Status grid — one tile per curated option, tap = saved immediately. The selected
                     tile stays highlighted (DisplayCategory is Neutral unless IsSelected).
                     2026-10-16: non-functional (disabled + dimmed), not hidden, when the picker is the
                     "nezařazen" placeholder (see MyRoomStatusItem.HasAssignment's own remarks) — still
                     shows what the options would be, just can't be tapped. -->
                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                            IsEnabled="{Binding ActiveRoomStatusPicker.HasAssignment}"
                            BindableLayout.ItemsSource="{Binding ActiveRoomStatusPicker.Options}">
                    <FlexLayout.Triggers>
                        <DataTrigger TargetType="FlexLayout" Binding="{Binding ActiveRoomStatusPicker.HasAssignment}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </FlexLayout.Triggers>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomStatusOptionTile">
                            <Border Margin="0,0,7,7" MinimumWidthRequest="146" HeightRequest="44" Padding="11,0" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 11"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=PickMyRoomStatusCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                    <BoxView Grid.Column="0" WidthRequest="7" HeightRequest="7" CornerRadius="3.5" VerticalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray400}}">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding DisplayCategory}" Value="Success">
                                                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding DisplayCategory}" Value="Info">
                                                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource InfoDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding DisplayCategory}" Value="Warn">
                                                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding DisplayCategory}" Value="Danger">
                                                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                    <Label Grid.Column="1" Text="{Binding Text}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Success">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Info">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource InfoDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Warn">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Danger">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="2" Text="✓" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" IsVisible="{Binding IsSelected}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Success">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Info">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource InfoDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Warn">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DisplayCategory}" Value="Danger">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding DisplayCategory}" Value="Success">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding DisplayCategory}" Value="Info">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding DisplayCategory}" Value="Warn">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource WarnSoftDark}}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding DisplayCategory}" Value="Danger">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="{Binding ActiveRoomStatusPicker.UpdatedInfoText}" FontSize="8.5" TextColor="Gray" IsVisible="{Binding ActiveRoomStatusPicker.HasCurrentStatus}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
