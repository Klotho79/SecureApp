<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:SettingsViewModel"
    Title="Nastavení"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Nastavení" Style="{StaticResource PageTitle}" />

            <!-- Sub-tabs (2026-09-24) — the page had grown to ~15 stacked cards in one scroll, which
                 the user found cluttered. Grouped into Uživatel / Systém / Admin, one shown at a time
                 (SettingsTab). The selected tab's button is highlighted via a DataTrigger on the
                 matching derived bool — converter-free. The Admin tab button only shows for admins. -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Text="Uživatel" Style="{StaticResource SecondaryButton}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsUserSettingsTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Systém" Style="{StaticResource SecondaryButton}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSystemSettingsTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="Admin" IsVisible="{Binding IsAdmin}" Style="{StaticResource SecondaryButton}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="2">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAdminSettingsTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- ============================ UŽIVATEL ============================ -->
            <VerticalStackLayout x:Name="UserTabContent" Spacing="12" IsVisible="{Binding IsUserSettingsTab}">

                <!-- Sub-tabs (2026-10-11) — see SettingsViewModel.Community's UserSubTab remarks. -->
                <FlexLayout Wrap="Wrap">
                    <Button Text="Účet" Style="{StaticResource SubTabButton}" Command="{Binding SelectUserSubTabCommand}" CommandParameter="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsUserAccountSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Vzhled" Style="{StaticResource SubTabButton}" Command="{Binding SelectUserSubTabCommand}" CommandParameter="1">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsUserAppearanceSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Zobrazení" Style="{StaticResource SubTabButton}" Command="{Binding SelectUserSubTabCommand}" CommandParameter="2">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsUserVisibilitySubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </FlexLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsUserAccountSubTab}">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Účet" Style="{StaticResource SectionHeader}" Margin="0" />

                        <!-- 2026-10-08: nudge pro existující zařízení, co mají jen starý Nick/Role pár,
                             ať doplní Jméno/Příjmení (jinak porovnání s kontakty ARIM níže nemá proti
                             čemu srovnávat). Mizí samo, jakmile jsou obě pole vyplněná a uložená. -->
                        <Border IsVisible="{Binding HasIncompleteProfile}" Stroke="Gray" StrokeThickness="1" Padding="10" Margin="0,0,0,4">
                            <Label Text="Nová verze přidala pole Jméno, Příjmení a Telefon — vyplňte je prosím níže a uložte, ať vás appka umí spárovat s kontaktem ARIM." FontSize="10" LineBreakMode="WordWrap" />
                        </Border>

                        <Label Text="Jméno" FontAttributes="Bold" />
                        <Entry Text="{Binding ProfileFirstName}" Placeholder="Jméno" />

                        <Label Text="Příjmení" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Entry Text="{Binding ProfileLastName}" Placeholder="Příjmení" />

                        <Label Text="Telefon" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Entry Text="{Binding ProfilePhone}" Placeholder="Telefon" Keyboard="Telephone" />

                        <Label Text="E-mail" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Entry Text="{Binding ProfileEmail}" Placeholder="E-mail" Keyboard="Email" />

                        <Label Text="Nick v chatu (volitelné)" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Entry Text="{Binding DisplayName}" Placeholder="Přezdívka pro chat — necháte-li prázdné, zobrazí se Jméno Příjmení" />

                        <Label Text="Role" FontAttributes="Bold" Margin="0,8,0,0" />
                        <Label Text="{Binding SelectedRole}" FontSize="13" />
                        <Label
                            Text="Roli přiděluje správce komunity — na tomto zařízení ji měnit nelze. Viewer může procházet a otevírat, ale ne vytvářet/mazat/importovat; Modifier a Admin mohou upravovat a psát na nástěnku."
                            FontSize="9.5"
                            TextColor="Gray" />

                        <Button Text="Uložit" Command="{Binding SaveCommand}" />
                        <Label Text="Uloženo." IsVisible="{Binding IsSaved}" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding ArimReconciliationStatusText}" IsVisible="{Binding HasArimReconciliationStatus}" FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsUserAppearanceSubTab}">
                <!-- Vzhled (2026-09-24, Phase 4) — světlý/tmavý/systém, projeví se hned. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Vzhled aplikace" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Motiv" FontAttributes="Bold" />
                        <Picker ItemsSource="{Binding ThemeModeChoices}" SelectedIndex="{Binding ThemeModeIndex}" />
                        <Label Text="Přepne světlý/tmavý režim — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />

                        <Label Text="Velikost písma" FontAttributes="Bold" Margin="0,10,0,0" />
                        <Picker ItemsSource="{Binding FontScaleChoices}" SelectedIndex="{Binding FontScaleIndex}" />
                        <Label Text="Zvětší/zmenší veškerý text v aplikaci, včetně chatu — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />

                        <Label Text="Barva aplikace" FontAttributes="Bold" Margin="0,10,0,0" />
                        <!-- Preset swatches — tapping one applies + stores it. Tap handled via the VM's
                             SelectAccentCommand (ancestor-bound, same pattern as the member Save button). -->
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding AccentPresets}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentSwatchItem">
                                    <Border StrokeThickness="0" BackgroundColor="{Binding SwatchColor}" WidthRequest="44" HeightRequest="44" Margin="4" StrokeShape="RoundRectangle 10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SelectAccentCommand}"
                                                CommandParameter="{Binding Hex}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Custom colour: hex + a preview square + apply. -->
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{Binding AccentPreviewColor}" WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding AccentHexInput}" Placeholder="#RRGGBB" FontSize="11" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Použít" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAccentCommand}" CommandParameter="{Binding AccentHexInput}" />
                        </Grid>
                        <Label Text="{Binding AccentStatusText}" IsVisible="{Binding HasAccentStatus}" FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Barvy typů rozpisu — per-device, applies on valid hex, no separate save. Moved
                     here from Systém/Rozpis (2026-10-12, user's own ask: "v nastaveni v systemu je
                     barva rozpisu, patri do uzivatele vzhled" — a per-device appearance setting
                     belongs under Vzhled, not Systém). -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Barvy typů rozpisu" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Barva každého typu (Práce, Dovolená, ...) na Rozpisu — jen na tomto zařízení." FontSize="9.5" TextColor="Gray" />

                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding WorkplaceColorItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AssignmentColorSettingItem">
                                    <Grid ColumnDefinitions="28,*,90,Auto" ColumnSpacing="8">
                                        <BoxView Grid.Column="0" CornerRadius="6" WidthRequest="24" HeightRequest="24" Color="{Binding Preview}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Label}" FontSize="11" VerticalOptions="Center" />
                                        <Entry Grid.Column="2" Text="{Binding HexInput}" FontSize="10.5" Placeholder="#RRGGBB" />
                                        <Button Grid.Column="3" Text="↺" Style="{StaticResource SecondaryButton}" WidthRequest="40" Padding="0" Command="{Binding ResetCommand}" IsEnabled="{Binding IsCustomized}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Chat (2026-09-26) — message font size + own-bubble colour, applied live. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Chat" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Velikost písma zpráv" FontAttributes="Bold" />
                        <Picker ItemsSource="{Binding ChatFontSizeChoices}" SelectedIndex="{Binding ChatFontSizeIndex}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <Label Grid.Column="0" Text="Barva mých bublin" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="{Binding ChatBubblePreviewColor}" WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 8" />
                        </Grid>
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding AccentPresets}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentSwatchItem">
                                    <Border StrokeThickness="0" BackgroundColor="{Binding SwatchColor}" WidthRequest="44" HeightRequest="44" Margin="4" StrokeShape="RoundRectangle 10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SelectChatBubbleColorCommand}"
                                                CommandParameter="{Binding Hex}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Button Text="Podle barvy aplikace" Style="{StaticResource SecondaryButton}" Command="{Binding SelectChatBubbleColorCommand}" CommandParameter="" HorizontalOptions="Start" />
                        <Label Text="Projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsUserVisibilitySubTab}">
                <!-- Zobrazení — per-tab show/hide, per-device. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Zobrazení" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Nástěnka" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsNotificationsTabVisible}" />
                        </Grid>
                        <Label Text="Přidá/skryje záložku Nástěnka — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Chaty" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsChatsTabVisible}" />
                        </Grid>
                        <Label Text="Přidá/skryje záložku Chaty — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Soubory" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsFilesTabVisible}" />
                        </Grid>
                        <Label Text="Přidá/skryje záložku Soubory (Knihovna a Dokumenty) — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Kontakty" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsContactsTabVisible}" />
                        </Grid>
                        <Label Text="Přidá/skryje záložku Kontakty — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Redakce" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsRedakceTabVisible}" />
                        </Grid>
                        <Label Text="Přidá/skryje záložku Redakce — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Logbook" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsLogbookVisible}" />
                        </Grid>
                        <Label Text="Přidá/skryje záložku Logbook (check-listy a záznam výkonů) — projeví se hned. Platí jen pro toto zařízení." FontSize="9.5" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ============================ SYSTÉM ============================ -->
            <VerticalStackLayout x:Name="SystemTabContent" Spacing="12" IsVisible="{Binding IsSystemSettingsTab}">

                <!-- Sub-tabs (2026-10-11) — see SettingsViewModel.Community's SystemSubTab remarks. -->
                <FlexLayout Wrap="Wrap">
                    <Button Text="Připojení" Style="{StaticResource SubTabButton}" Command="{Binding SelectSystemSubTabCommand}" CommandParameter="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSystemConnectionSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Identita" Style="{StaticResource SubTabButton}" Command="{Binding SelectSystemSubTabCommand}" CommandParameter="1">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSystemIdentitySubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Opicentrum" Style="{StaticResource SubTabButton}" Command="{Binding SelectSystemSubTabCommand}" CommandParameter="2">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSystemOpicentrumSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Aktualizace" Style="{StaticResource SubTabButton}" Command="{Binding SelectSystemSubTabCommand}" CommandParameter="3">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSystemUpdateSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Knihovna" Style="{StaticResource SubTabButton}" Command="{Binding SelectSystemSubTabCommand}" CommandParameter="4">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSystemLibrarySubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Diagnostika" Style="{StaticResource SubTabButton}" IsVisible="{Binding IsAdminEffective}" Command="{Binding SelectSystemSubTabCommand}" CommandParameter="5">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSystemDiagnosticsSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="PICC" Style="{StaticResource SubTabButton}" IsVisible="{Binding IsPiccTeam}" Command="{Binding SelectSystemSubTabCommand}" CommandParameter="6">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSystemPiccSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </FlexLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSystemConnectionSubTab}">
                <!-- Zprávy na pozadí (2026-09-26) — Android only. -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsBackgroundRunSupported}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Zprávy na pozadí" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="{Binding BackgroundRunStatusText}" FontSize="10" LineBreakMode="WordWrap" />
                        <Button Text="Nastavit běh na pozadí" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Command="{Binding OpenBackgroundRunSettingsCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsBackgroundRunAllowed}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Relay" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="{Binding ConnectionStatusText}" FontSize="9.5" TextColor="Gray" />
                        <Label Text="{Binding RelayErrorMessage}" IsVisible="{Binding HasRelayError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />

                        <Entry Text="{Binding RelayEndpointText}" Placeholder="Adresa relay serveru, např. ws://10.8.0.1:8080" />

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsNotRegistered}">
                            <Entry Text="{Binding ActivationEmailText}" Placeholder="Váš e-mail (ideálně pracovní)" Keyboard="Email" />
                            <Button Text="Aktivovat" Command="{Binding RequestActivationCommand}" IsEnabled="{Binding CanUseRelayControls}" />
                            <Label Text="{Binding ActivationStatusText}" IsVisible="{Binding HasActivationStatus}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                        </VerticalStackLayout>

                        <Button Text="Připojit" Command="{Binding ConnectToRelayCommand}" IsVisible="{Binding IsNotConnected}" IsEnabled="{Binding CanUseRelayControls}" />
                        <Button Text="Odpojit" Style="{StaticResource SecondaryButton}" Command="{Binding DisconnectFromRelayCommand}" IsVisible="{Binding IsConnected}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Profil (2026-10-05, Windows multi-profile login — Profiles.ActiveProfile's own
                     remarks): this PC is shared by several people, each with their own profile. Only
                     shown when a profile is actually active (i.e. on Windows, logged in). -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasActiveProfile}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Profil" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="{Binding ActiveProfileNameText}" FontSize="11" />
                        <Button Text="Odhlásit se" Style="{StaticResource SecondaryButton}" Command="{Binding LogOutCommand}" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSystemIdentitySubTab}">
                <!-- Identita: zálohovat/obnovit (2026-09-29, disaster recovery po skutečné ztrátě
                     identity na S23+ tuhle session) — "Zálohovat" jen když je zařízení zaregistrované
                     (je co zálohovat), "Obnovit" jen dokud NENÍ (jinak by to přepsalo živou identitu —
                     IMessagingService.RestoreLocalIdentityAsync to ostatně serverově i tak odmítne). -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsRegistered}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Záloha identity" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Zálohuje jen to, čím vás appka pozná (ne historii zpráv — ta je end-to-end šifrovaná a existuje jen v tomto telefonu). Po ztrátě/smazání appky umožní obnovit STEJNOU identitu místo založení nové." FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                        <Entry Text="{Binding IdentityBackupEmailText}" Placeholder="E-mail (klíč k záloze na relay serveru)" Keyboard="Email" />
                        <Entry Text="{Binding IdentityBackupPassphraseText}" Placeholder="Heslo zálohy (min. 8 znaků)" IsPassword="True" />
                        <Entry Text="{Binding IdentityBackupPassphraseConfirmText}" Placeholder="Heslo znovu" IsPassword="True" />
                        <Button Text="Zálohovat identitu" Command="{Binding BackupIdentityCommand}" IsEnabled="{Binding CanBackupIdentity}" />
                        <controls:DelayedActivityIndicator IsBusy="{Binding IsBackingUpIdentity}" HorizontalOptions="Center" />
                        <Label Text="{Binding IdentityBackupStatusText}" IsVisible="{Binding HasIdentityBackupStatus}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsNotRegistered}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Obnovit identitu ze zálohy" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Máte zálohu z dřívějška (stejný e-mail a heslo, co jste zadali při zálohování)? Obnovte identitu PŘED klepnutím na Aktivovat výše — ostatní vás pak poznají jako stejnou osobu, ne jako nové zařízení." FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                        <Entry Text="{Binding RestoreEmailText}" Placeholder="E-mail použitý při zálohování" Keyboard="Email" />
                        <Entry Text="{Binding RestorePassphraseText}" Placeholder="Heslo zálohy" IsPassword="True" />
                        <Button Text="Obnovit z relay serveru" Command="{Binding RestoreIdentityFromRelayCommand}" IsEnabled="{Binding CanRestoreIdentity}" />
                        <Button Text="Obnovit ze souboru v telefonu" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreIdentityFromFileCommand}" IsEnabled="{Binding CanRestoreIdentity}" />
                        <controls:DelayedActivityIndicator IsBusy="{Binding IsRestoringIdentity}" HorizontalOptions="Center" />
                        <Label Text="{Binding RestoreStatusText}" IsVisible="{Binding HasRestoreStatus}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSystemOpicentrumSubTab}">
                <!-- Opicentrum — third-party login for the ARO staff portal the Rozpis syncs from. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Opicentrum (rozpis)" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Přihlašovací údaje k opicentrum.cz/ARO — appka se jimi sama přihlásí při každém otevření Rozpisu a stáhne aktuální směny. Heslo se ukládá jen v šifrovaném úložišti tohoto zařízení." FontSize="9.5" TextColor="Gray" />
                        <Label Text="{Binding OpicentrumStatusText}" IsVisible="{Binding HasOpicentrumStatus}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" LineBreakMode="WordWrap" />

                        <Label Text="✓ Přihlašovací údaje jsou nastavené." FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasOpicentrumCredentials}" />

                        <Entry Text="{Binding OpicentrumUsernameInput}" Placeholder="Uživatelské jméno" />
                        <Entry Text="{Binding OpicentrumPasswordInput}" Placeholder="Heslo" IsPassword="True" />
                        <Button Text="Uložit přihlašovací údaje" Command="{Binding SaveOpicentrumCredentialsCommand}" IsEnabled="{Binding CanSaveOpicentrumCredentials}" />
                        <Button Text="Odstranit přihlašovací údaje" Style="{StaticResource SecondaryButton}" Command="{Binding ClearOpicentrumCredentialsCommand}" IsVisible="{Binding HasOpicentrumCredentials}" />

                        <!-- 2026-10-10: admin kontrola ARIM seznamu (z WhatsAppu) proti jménům v Opicentru - viz OpicentrumNameCheck. -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsAdmin}" Margin="0,6,0,0">
                            <Button Text="Porovnat ARIM kontakty s Opicentrem" Style="{StaticResource SecondaryButton}" Command="{Binding CheckOpicentrumNamesCommand}" IsEnabled="{Binding CanCheckOpicentrumNames}" IsVisible="{Binding HasOpicentrumCredentials}" />
                            <Label Text="{Binding OpicentrumNameCheckReport}" IsVisible="{Binding HasOpicentrumNameCheckReport}" FontSize="10" LineBreakMode="WordWrap" />
                            <Button Text="Kopírovat výsledek" Style="{StaticResource SecondaryButton}" Command="{Binding CopyOpicentrumNameCheckReportCommand}" IsVisible="{Binding HasOpicentrumNameCheckReport}" />

                            <!-- 2026-10-14, user's own ask: kompletní sálové rozvržení tohoto týdne z pracoviste.php, filtrované na sál/ostatní/ODS/oční — stejná klíčová slova jako Status gate na Nástěnce. -->
                            <Button Text="Stáhnout sálové rozvržení (sál/ostatní/ODS/oční)" Style="{StaticResource SecondaryButton}" Command="{Binding CheckOpicentrumWorkplacesCommand}" IsEnabled="{Binding CanCheckOpicentrumWorkplaces}" IsVisible="{Binding HasOpicentrumCredentials}" Margin="0,8,0,0" />
                            <Label Text="{Binding OpicentrumWorkplaceCheckReport}" IsVisible="{Binding HasOpicentrumWorkplaceCheckReport}" FontSize="10" LineBreakMode="WordWrap" />
                            <Button Text="Kopírovat výsledek" Style="{StaticResource SecondaryButton}" Command="{Binding CopyOpicentrumWorkplaceCheckReportCommand}" IsVisible="{Binding HasOpicentrumWorkplaceCheckReport}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSystemUpdateSubTab}">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Aktualizace appky" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="{Binding CurrentVersionText}" FontSize="9.5" TextColor="Gray" />
                        <Button Text="Zkontrolovat aktualizaci" Style="{StaticResource SecondaryButton}" Command="{Binding CheckForUpdateCommand}" IsEnabled="{Binding CanCheckForUpdate}" />
                        <Button Text="Stáhnout a nainstalovat" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadAndInstallUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}" IsEnabled="{Binding CanDownloadUpdate}" />
                        <ProgressBar Progress="{Binding UpdateDownloadProgress}" IsVisible="{Binding IsDownloadingUpdate}" />
                        <Label Text="{Binding UpdateStatusText}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasUpdateStatus}" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSystemLibrarySubTab}">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Klíč sdílené knihovny" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Jeden klíč, sdílený všemi v komunitě, chrání každý soubor ve sdílené knihovně. Appka si ho sama vyžádá z relay/od ostatních zařízení na pozadí — nic se nezadává ručně." FontSize="9.5" TextColor="Gray" />
                        <Label Text="✓ Toto zařízení má klíč sdílené knihovny." FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasSharedLibraryKey}" />
                        <Label Text="Klíč se získává na pozadí…" FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoSharedLibraryKey}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Správa kategorií knihovny přesunuta do Redakce (2026-10-13, user's own ask:
                     "V nastaveni sytem kategorie knihovny patri taky do redakce"). -->
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSystemDiagnosticsSubTab}">
                <!-- Diagnostický log — every device still reports into it, but only the admin reads it (2026-09-26, user's call). IsAdminEffective so an admin previewing a lower role sees it disappear too. -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsAdminEffective}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Diagnostický log" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Sdílené chybové/varovné hlášení ze všech zařízení v komunitě." FontSize="9.5" TextColor="Gray" />
                        <Label Text="{Binding DiagnosticLogErrorMessage}" IsVisible="{Binding HasDiagnosticLogError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="1" Text="⟳ Obnovit" Style="{StaticResource SecondaryButton}" Command="{Binding LoadDiagnosticLogCommand}" />
                        </Grid>
                        <controls:DelayedActivityIndicator IsBusy="{Binding IsLoadingDiagnosticLog}" HorizontalOptions="Center" />

                        <Label Text="Žádné záznamy." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoDiagnosticLogEntries}" />

                        <CollectionView ItemsSource="{Binding DiagnosticLogEntries}" IsVisible="{Binding HasDiagnosticLogEntries}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticLogItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                        <VerticalStackLayout Spacing="2">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding Level}" FontAttributes="Bold" FontSize="9">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Info">
                                                            <Setter Property="TextColor" Value="Gray" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Grid.Column="1" Text="{Binding DeviceDisplayName}" FontAttributes="Bold" FontSize="10" />
                                                <Label Grid.Column="2" Text="{Binding TimeText}" FontSize="9" TextColor="Gray" />
                                            </Grid>
                                            <Label Text="{Binding Message}" FontSize="10" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Context}" FontSize="8.5" FontFamily="Courier" TextColor="Gray" IsVisible="{Binding HasContext}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSystemPiccSubTab}">
                <!-- PICC rozpis (2026-10-12) — jen pro zařízení s příznakem „PICC tým“ (admin ho nastaví
                     ve Správa členů). Dnešní lékař je navíc veřejný ve widgetu na Androidu pro
                     všechny, sestry vidí jen tahle karta. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Rozpis PICC" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Nahrajte xlsx se záložkou „Lékaři“ (datum, lékař, sestry). Dnešní lékař se zobrazí ve widgetu na Androidu všem; sestry vidí jen zařízení s tímto příznakem." FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                        <Button Text="📤 Nahrát nový rozpis (.xlsx)" Command="{Binding UploadPiccRosterCommand}" IsEnabled="{Binding CanUploadPiccRoster}" />
                        <controls:DelayedActivityIndicator IsBusy="{Binding IsUploadingPiccRoster}" HorizontalOptions="Center" />
                        <Label Text="{Binding PiccReportText}" IsVisible="{Binding HasPiccReport}" FontSize="10.5" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ============================ ADMIN ============================ -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminSettingsTab}">

                <!-- Admin heslo — shared by every admin action below; never stored. Stays above the
                     sub-tabs (not inside one) since it's used across several of them. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Admin heslo relay serveru (SECUREAPP_RELAY_ADMIN_SECRET) — zadej před každou akcí, nikam se neukládá" FontSize="9.5" TextColor="Gray" />
                        <Entry Text="{Binding AdminSecretInputText}" Placeholder="Admin heslo" IsPassword="True" />
                        <Label Text="{Binding AdminErrorMessage}" IsVisible="{Binding HasAdminError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Sub-tabs (2026-10-11) — see SettingsViewModel.Community's AdminSubTab remarks. -->
                <FlexLayout Wrap="Wrap">
                    <Button Text="Ladění" Style="{StaticResource SubTabButton}" Command="{Binding SelectAdminSubTabCommand}" CommandParameter="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsAdminDebugSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Logy" Style="{StaticResource SubTabButton}" Command="{Binding SelectAdminSubTabCommand}" CommandParameter="1">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsAdminLogsSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Členové" Style="{StaticResource SubTabButton}" Command="{Binding SelectAdminSubTabCommand}" CommandParameter="2">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsAdminMembersSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Nasazení" Style="{StaticResource SubTabButton}" Command="{Binding SelectAdminSubTabCommand}" CommandParameter="3">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsAdminDeploySubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="AI překlad" Style="{StaticResource SubTabButton}" IsVisible="{Binding CanConfigureLocalAiTranslation}" Command="{Binding SelectAdminSubTabCommand}" CommandParameter="4">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsAdminAiSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Nový člen" Style="{StaticResource SubTabButton}" Command="{Binding SelectAdminSubTabCommand}" CommandParameter="5">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsAdminNewMemberSubTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </FlexLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminDebugSubTab}">
                <!-- Ladění: dočasně povolit snímky obrazovky na tomto zařízení (2026-10-11) — vyprší samo po 24 h. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ladění" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Povolit snímky obrazovky" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsScreenCaptureAllowed}" />
                        </Grid>
                        <Label Text="{Binding ScreenCaptureStatusText}" FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                        <Label Text="Jen pro toto zařízení, na 24 hodin. Pak se ochrana zapne sama." FontSize="9.5" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <!-- Náhled jako role (2026-10-13, user's own ask: "v nastaveni admina dej rolmenu
                     zobrazeni co vidi jednotlive role") — živý náhled, ne jen popis: appka se po
                     zvolení Modifier/Viewer všude chová (skrývá karty/tlačítka), jako by na tomhle
                     zařízení byla přihlášená ta role. Nic se neukládá, při vypnutí appky se náhled
                     sám zruší. Admin heslo a reálná role zůstávají nedotčené — náhled jen schovává
                     ovládací prvky, nikdy nezmění, co appka ve skutečnosti udělá. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Náhled jako role" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Appka se zobrazí přesně tak, jak ji vidí zvolená role — na tomto zařízení, dokud náhled nezrušíte nebo appku nezavřete." FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                        <Picker ItemsSource="{Binding PreviewRoleOptions}" SelectedItem="{Binding SelectedPreviewRoleOption}" Title="Role" />
                        <Label Text="{Binding SelectedPreviewRoleOption, StringFormat='Aktivní náhled: {0}'}" IsVisible="{Binding HasActivePreview}" FontSize="9.5" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminLogsSubTab}">
                <!-- Log stažení dokumentů (2026-09-30, user's own ask: "bude log kdo co kdy stahl
                     podle dokumentu vyhledatelny") — every "Stáhnout" tap in DocumentViewerPage logs
                     here; admin-only search by document title, newest first. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Log stažení dokumentů" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Kdo, co a kdy stáhl tlačítkem Stáhnout v prohlížeči dokumentů — hledej podle názvu dokumentu, prázdné pole zobrazí vše." FontSize="9.5" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding DocumentDownloadSearchText}" Placeholder="Název dokumentu (nebo prázdné = vše)" />
                            <Button Grid.Column="1" Text="Hledat" Command="{Binding SearchDocumentDownloadsCommand}" />
                        </Grid>
                        <controls:DelayedActivityIndicator IsBusy="{Binding IsSearchingDocumentDownloads}" HorizontalOptions="Center" />
                        <Label Text="Žádné záznamy." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoDocumentDownloadResults}" />

                        <CollectionView ItemsSource="{Binding DocumentDownloadResults}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentDownloadLogItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding DocumentTitle}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding DisplayName}" FontSize="9.5" TextColor="Gray" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding DownloadedAtText}" FontSize="9" TextColor="Gray" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Log schvalování dokumentů (2026-10-01, content-approval workflow) — every
                     approve/reject decision from the Document Library review queue logs here;
                     admin-only search by document title, newest first. Direct structural twin of the
                     download-log card above. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Log schvalování dokumentů" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Kdo, co a kdy schválil nebo zamítl v knihovně postupů — hledej podle názvu dokumentu, prázdné pole zobrazí vše." FontSize="9.5" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding LibraryDocumentAuditSearchText}" Placeholder="Název dokumentu (nebo prázdné = vše)" />
                            <Button Grid.Column="1" Text="Hledat" Command="{Binding SearchLibraryDocumentAuditCommand}" />
                        </Grid>
                        <controls:DelayedActivityIndicator IsBusy="{Binding IsSearchingLibraryDocumentAudit}" HorizontalOptions="Center" />
                        <Label Text="Žádné záznamy." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoLibraryDocumentAuditResults}" />

                        <CollectionView ItemsSource="{Binding LibraryDocumentAuditResults}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryDocumentAuditItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Decision}" FontSize="11" FontAttributes="Bold" />
                                                <Label Text="{Binding Comment}" FontSize="9.5" TextColor="Gray" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding DecidedAtText}" FontSize="9" TextColor="Gray" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminMembersSubTab}">
                <!-- Členové (2026-10-17: sloučeno s dřívější samostatnou záložkou "Zařízení", user's
                     own ask) — vyberte člena z rolovacího menu, uvidíte jeho sdílený e-mail jednou
                     nahoře a VŠECHNA jeho zařízení pod tím, každé s rolí/viditelností záložek i se
                     stavem/logy/odregistrováním, co dřív bylo na samostatné záložce. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Admin: Členové" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Vyberte člena — uvidíte jeho e-mail a všechna jeho zařízení, u každého roli, viditelnost záložek, stav a možnost odregistrovat." FontSize="9.5" TextColor="Gray" />
                        <Button Text="⟳ Načíst členy" Style="{StaticResource SecondaryButton}" Command="{Binding LoadMembersCommand}" />
                        <controls:DelayedActivityIndicator IsBusy="{Binding IsLoadingMembers}" HorizontalOptions="Center" />
                        <Label Text="{Binding MemberManagementStatusText}" IsVisible="{Binding HasMemberManagementStatus}" FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />

                        <Picker Title="Člen" ItemsSource="{Binding MemberGroups}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedMemberGroup}" />

                        <!-- Sdílený e-mail (2026-10-17, user's own ask: "Jeden e-mail na člena, ne na
                             zařízení") — jednou nahoře nad seznamem zařízení vybraného člena, zdroj je
                             kontakt ARIM. -->
                        <Label Text="{Binding SelectedMemberGroup.Email, StringFormat='✉ {0}'}" IsVisible="{Binding SelectedMemberGroup.HasEmail}" FontSize="10.5" FontAttributes="Bold" />

                        <CollectionView ItemsSource="{Binding SelectedMemberGroup.Devices}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MemberPolicyItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="11.5" />
                                            <Label Text="{Binding LastSeenText}" FontSize="9" TextColor="Gray" />
                                            <Label Text="{Binding AppVersionText}" FontSize="9" TextColor="Gray" />
                                            <!-- Staleness/pending outbox (2.1, 2026-09-17) — merged in here 2026-10-17 from the former separate "Zařízení" tab. -->
                                            <Label Text="{Binding DeviceStatusText}" FontSize="9" TextColor="Gray" />
                                            <Label Text="{Binding PendingText}" FontSize="9"
                                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding HasPendingMessages}" Value="False">
                                                        <Setter Property="TextColor" Value="Gray" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                                <Button Grid.Column="0" Text="📄 Log chyb" Style="{StaticResource SecondaryButton}" Command="{Binding ShowErrorsCommand}" CommandParameter="{Binding DeviceId}" />
                                                <Button Grid.Column="1" Text="📊 Log událostí" Style="{StaticResource SecondaryButton}" Command="{Binding ShowEventsCommand}" CommandParameter="{Binding DeviceId}" />
                                            </Grid>
                                            <!-- Shared library key status (2026-10-12) — see ManagedDevice's own remarks. The resend
                                                 button only shows when missing; there's nothing to "resend" for a member who already has it. -->
                                            <Label Text="{Binding SharedLibraryKeyText}" FontSize="9">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding HasSharedLibraryKey}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding HasSharedLibraryKey}" Value="False">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Button Text="🔄 Odeslat klíč znovu" Style="{StaticResource SecondaryButton}" IsVisible="{Binding MissingSharedLibraryKey}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=ResendSharedLibraryKeyCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Label Text="Role" FontSize="9" TextColor="Gray" Margin="0,4,0,0" />
                                            <Picker ItemsSource="{Binding RoleChoices}" SelectedIndex="{Binding SelectedRoleIndex}" />
                                            <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Chaty" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ShowChaty}" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Soubory" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ShowSoubory}" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Kontakty" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ShowKontakty}" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Nástěnka" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ShowNastenka}" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Logbook" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ShowLogbook}" /></Grid>
                                            <!-- 2026-10-01, content-approval workflow — orthogonal to Role, see DevicePolicy.IsDocumentReviewer's own remarks. -->
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0"><Label Grid.Column="0" Text="Reviewer dokumentů" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding IsDocumentReviewer}" /></Grid>
                                            <!-- 2026-10-12, PICC roster — orthogonal to Role, see DevicePolicy.IsPiccTeam's own remarks. -->
                                            <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="PICC tým" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding IsPiccTeam}" /></Grid>
                                            <Button Text="Uložit"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SaveMemberPolicyCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Label Text="{Binding StatusText}" FontSize="9" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                            <Label Text="Zadej admin heslo výše, pak:" FontSize="8.5" TextColor="Gray" Margin="0,4,0,0" />
                                            <Button Text="🗑 Odregistrovat" Style="{StaticResource SecondaryButton}" Command="{Binding DeregisterCommand}" CommandParameter="{Binding DeviceId}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- One device's uploaded app log (2026-09-26) — see Diagnostics.AppLogUploader. -->
                        <Border Style="{StaticResource CardBorder}" Margin="0" IsVisible="{Binding HasDeviceLog}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding DeviceLogTitle}" FontAttributes="Bold" FontSize="10" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="✕" Style="{StaticResource SecondaryButton}" WidthRequest="40" Padding="0" Command="{Binding CloseDeviceLogCommand}" />
                                </Grid>
                                <Label Text="{Binding DeviceLogText}" FontSize="8" FontFamily="monospace" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminDeploySubTab}">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Admin: Nasazení relay serveru" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Znovu sestaví a restartuje relay server z posledního kódu nahraného na Pi (git push). Pro tento krok není potřeba SSH — jednorázové nastavení Pi najdete v relay/ops/README.md. Použije stejné admin heslo zadané výše." FontSize="9.5" TextColor="Gray" />

                        <Button Text="Znovu nasadit relay" Style="{StaticResource SecondaryButton}" Command="{Binding RedeployRelayCommand}" IsEnabled="{Binding CanUseAdminControls}" />
                        <Label Text="{Binding DeployStatusText}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasDeployStatus}" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminAiSubTab}">
                <!-- Admin-only local-AI PDF translation (2026-10-05) — only ever visible on Windows, since Ollama/LM Studio run on the admin's own PC. -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CanConfigureLocalAiTranslation}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Admin: Místní AI překlad" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Model místního AI (Ollama/LM Studio) běžícího na tomto PC — použije se při překladu dokumentů v Knihovně. Nic odtud nikdy neopustí tento počítač." FontSize="9.5" TextColor="Gray" />
                        <!-- 2026-10-09: vyber ze stažených modelů místo opisování adresy a názvu - viz LocalAiModelDiscovery. -->
                        <Button Text="🔍 Najít stažené modely" Style="{StaticResource SecondaryButton}" Command="{Binding FindLocalAiModelsCommand}" IsEnabled="{Binding CanTestLocalAiConnection}" />
                        <Picker Title="Vyberte model" ItemsSource="{Binding LocalAiModels}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedLocalAiModel}" IsVisible="{Binding HasLocalAiModels}" />
                        <Label Text="Ruční nastavení (není potřeba, když vyberete model výše):" FontSize="9" TextColor="Gray" Margin="0,4,0,0" />
                        <Entry Placeholder="http://localhost:11434" Text="{Binding LocalAiBaseUrlText}" />
                        <Entry Placeholder="Název modelu (např. qwen2.5:7b)" Text="{Binding LocalAiModelNameText}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="Uložit" Style="{StaticResource SecondaryButton}" Command="{Binding SaveLocalAiTranslationSettingsCommand}" />
                            <Button Grid.Column="1" Text="Testovat připojení" Style="{StaticResource SecondaryButton}" Command="{Binding TestLocalAiConnectionCommand}" IsEnabled="{Binding CanTestLocalAiConnection}" />
                        </Grid>
                        <Label Text="{Binding LocalAiTranslationStatusText}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasLocalAiTranslationStatus}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminNewMemberSubTab}">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Přidat nového člena" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Label Text="Krok 1: Nový člen/zařízení zatím nemá přístup do naší sítě. Zadejte jméno (každé zařízení/PC potřebuje svůj VLASTNÍ přístup, nelze použít jeden pro víc zařízení najednou) a vytvořte WireGuard přístup — telefon naskenuje QR v appce WireGuard (jiná appka, z Google Play); PC nemá čtečku QR, použijte tlačítko dole a naimportujte .conf přímo do WireGuard klienta pro Windows." FontAttributes="Bold" FontSize="10.5" />
                        <Entry Placeholder="Jméno nového člena/zařízení" Text="{Binding NewMemberNameText}" />
                        <Label Text="Role nového člena (uloží se na relay, jakmile si appku poprvé zaregistruje):" FontSize="9.5" TextColor="Gray" />
                        <Picker ItemsSource="{Binding NewMemberRoleChoices}" SelectedIndex="{Binding NewMemberRoleIndex}" />
                        <Button Text="Vytvořit WireGuard přístup" Style="{StaticResource SecondaryButton}" Command="{Binding CreateWireGuardAccessCommand}" IsEnabled="{Binding CanCreateWireGuardAccess}" />
                        <Image Source="{Binding WireGuardQrImage}" HeightRequest="180" WidthRequest="180" HorizontalOptions="Center" IsVisible="{Binding HasWireGuardQrImage}" />
                        <Button Text="⬇ Stáhnout .conf (pro PC)" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadWireGuardConfigCommand}" IsVisible="{Binding HasWireGuardConfigText}" />
                        <!-- 2026-10-08: samoobslužná instalace pro ne-admin kolegu - JEDEN odkaz (kód zabudovaný
                             uvnitř staženého .bat, viz /download/onboarding/{code} v relay Program.cs), bez
                             opisování kódu, bez admin hesla a bez předávání .conf souboru. -->
                        <Border IsVisible="{Binding HasWireGuardPickupLink}" Stroke="Gray" StrokeThickness="1" Padding="10" Margin="0,4,0,0">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Odkaz pro samoobslužnou instalaci (24h, jen jednou):" FontSize="9" TextColor="Gray" />
                                <Label Text="{Binding WireGuardPickupLink}" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Button Text="Kopírovat odkaz" Style="{StaticResource SecondaryButton}" Command="{Binding CopyWireGuardPickupCodeCommand}" />
                                <Label Text="Kolegovi pošlete jen tento odkaz — klikne, stáhne se new-pc-onboarding.bat s kódem už uvnitř, spustí, nic neopisuje." FontSize="9" TextColor="Gray" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="{Binding WireGuardStatusText}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasWireGuardStatus}" />

                        <BoxView HeightRequest="1" BackgroundColor="Gray" Opacity="0.3" Margin="0,6" />

                        <Label Text="Krok 2: Až je připojený k WireGuard, naskenuje tenhle QR (nebo mu pošlete odkaz) — otevře se stránka se stažením appky a návodem k instalaci." FontAttributes="Bold" FontSize="10.5" />
                        <Image Source="{Binding DownloadShareQrImage}" HeightRequest="180" WidthRequest="180" HorizontalOptions="Center" />
                        <Label Text="{Binding DownloadShareUrl}" FontSize="9.5" TextColor="Gray" LineBreakMode="CharacterWrap" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
