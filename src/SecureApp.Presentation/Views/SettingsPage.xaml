<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:SettingsViewModel"
    Title="Nastavení">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Účet" Style="{StaticResource SectionHeader}" Margin="0" />

                    <Label Text="Zobrazované jméno" FontAttributes="Bold" />
                    <Entry Text="{Binding DisplayName}" Placeholder="Vaše jméno" />

                    <Label Text="Role" FontAttributes="Bold" Margin="0,8,0,0" />
                    <Picker ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}" />
                    <Label
                        Text="Viewer může procházet a otevírat dokumenty, ale nemůže vytvářet, přejmenovávat, přesouvat, mazat ani importovat."
                        FontSize="12"
                        TextColor="Gray" />

                    <Button Text="Uložit" Command="{Binding SaveCommand}" />
                    <Label Text="Uloženo." IsVisible="{Binding IsSaved}" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Chaty/Soubory/Kontakty toggles added 2026-09-16 (user's own ask: "chci mít možnost
                 schovávat jednotlivé menu kromě settings samozřejmě") — same Grid+Switch+description
                 pattern as the pre-existing Logbook row, one per hideable tab. Nastavení itself has no
                 row here on purpose: it can never be hidden (see AppShell's own remarks). -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Zobrazení" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Chaty" VerticalOptions="Center" FontAttributes="Bold" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsChatsTabVisible}" />
                    </Grid>
                    <Label Text="Přidá/skryje záložku Chaty — projeví se hned. Platí jen pro toto zařízení." FontSize="12" TextColor="Gray" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Soubory" VerticalOptions="Center" FontAttributes="Bold" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsFilesTabVisible}" />
                    </Grid>
                    <Label Text="Přidá/skryje záložku Soubory (Knihovna a Dokumenty) — projeví se hned. Platí jen pro toto zařízení." FontSize="12" TextColor="Gray" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Kontakty" VerticalOptions="Center" FontAttributes="Bold" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsContactsTabVisible}" />
                    </Grid>
                    <Label Text="Přidá/skryje záložku Kontakty — projeví se hned. Platí jen pro toto zařízení." FontSize="12" TextColor="Gray" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Logbook" VerticalOptions="Center" FontAttributes="Bold" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsLogbookVisible}" />
                    </Grid>
                    <Label Text="Přidá/skryje záložku Logbook (check-listy a záznam výkonů) — projeví se hned. Platí jen pro toto zařízení." FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Relay" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="{Binding ConnectionStatusText}" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding RelayErrorMessage}" IsVisible="{Binding HasRelayError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />

                    <Entry Text="{Binding RelayEndpointText}" Placeholder="Adresa relay serveru, např. ws://10.8.0.1:8080" />

                    <!-- Activation (2026-09-06, auto-approve 2026-09-19) — this device sends its
                         name + email + own key fingerprint and the relay approves it on receipt, no
                         waiting, no code needed. See SettingsViewModel.RequestActivationAsync's own
                         remarks. The old separate "Mám kód pozvánky" path (and the admin-side "Kódy
                         pozvánky" card that minted them) is gone — auto-approve made it strictly
                         redundant with this single button. -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsNotRegistered}">
                        <Entry Text="{Binding ActivationEmailText}" Placeholder="Váš e-mail (ideálně pracovní)" Keyboard="Email" />
                        <Button Text="Aktivovat" Command="{Binding RequestActivationCommand}" IsEnabled="{Binding CanUseRelayControls}" />
                        <Label Text="{Binding ActivationStatusText}" IsVisible="{Binding HasActivationStatus}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                    </VerticalStackLayout>

                    <Button Text="Připojit" Command="{Binding ConnectToRelayCommand}" IsVisible="{Binding IsNotConnected}" IsEnabled="{Binding CanUseRelayControls}" />
                    <Button Text="Odpojit" Style="{StaticResource SecondaryButton}" Command="{Binding DisconnectFromRelayCommand}" IsVisible="{Binding IsConnected}" />
                </VerticalStackLayout>
            </Border>

            <!-- Admin heslo (2026-09-07) — sdílené všemi admin akcemi níže (Zařízení, Nasazení relay);
                 nikdy se neukládá, ani v appce, ani na disku, zadává se vždy znovu
                 před KAŽDOU jednotlivou admin akcí a appka ho hned po použití zahodí. Uživatelovo
                 vlastní rozhodnutí po posouzení, že i zašifrované úložiště (Windows DPAPI) chrání jen
                 proti někomu bez přihlášení k tomuto zařízení, ne proti něčemu, co už pod ním běží. -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsAdmin}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Admin heslo relay serveru (SECUREAPP_RELAY_ADMIN_SECRET) — zadej před každou akcí, nikam se neukládá" FontSize="12" TextColor="Gray" />
                    <Entry Text="{Binding AdminSecretInputText}" Placeholder="Admin heslo" IsPassword="True" />
                    <Label Text="{Binding AdminErrorMessage}" IsVisible="{Binding HasAdminError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Zařízení (2.1, 2026-09-17) — vidí staleness (kdy naposledy zařízení publikovalo do
                 adresáře) a kolik zpráv na něj čeká ve frontě; umožňuje odregistrovat mrtvé zařízení
                 přímo v appce (dřív jen ruční SSH + SQLite dotazy na relay). -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsAdmin}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Admin: Zařízení" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Seznam registrovaných zařízení — kdy naposledy zařízení bylo aktivní v adresáři a kolik zpráv na něj čeká. Nedostupné zařízení lze odsud rovnou odregistrovat." FontSize="12" TextColor="Gray" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="1" Text="⟳ Obnovit" Style="{StaticResource SecondaryButton}" Command="{Binding LoadRegisteredDevicesCommand}" />
                    </Grid>
                    <controls:DelayedActivityIndicator IsBusy="{Binding IsLoadingDevices}" HorizontalOptions="Center" />

                    <Label Text="Žádná zařízení nenalezena." FontSize="12" TextColor="Gray" IsVisible="{Binding HasNoRegisteredDevices}" />

                    <CollectionView ItemsSource="{Binding RegisteredDevices}" IsVisible="{Binding HasRegisteredDevices}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RegisteredDeviceItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="14.5" />
                                        <Label Text="{Binding StatusText}" FontSize="11.5" TextColor="Gray" />
                                        <Label Text="{Binding PendingText}" FontSize="11.5"
                                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasPendingMessages}" Value="False">
                                                    <Setter Property="TextColor" Value="Gray" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="Zadej admin heslo výše, pak:" FontSize="10.5" TextColor="Gray" Margin="0,4,0,0" />
                                        <Button Text="🗑 Odregistrovat" Style="{StaticResource SecondaryButton}" Command="{Binding DeregisterCommand}" CommandParameter="{Binding Id}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsAdmin}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Admin: Nasazení relay serveru" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Znovu sestaví a restartuje relay server z posledního kódu nahraného na Pi (git push). Pro tento krok není potřeba SSH — jednorázové nastavení Pi najdete v relay/ops/README.md. Použije stejné admin heslo zadané výše." FontSize="12" TextColor="Gray" />

                    <Button Text="Znovu nasadit relay" Style="{StaticResource SecondaryButton}" Command="{Binding RedeployRelayCommand}" IsEnabled="{Binding CanUseAdminControls}" />
                    <Label Text="{Binding DeployStatusText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasDeployStatus}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Klíč sdílené knihovny" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Jeden klíč, sdílený všemi v komunitě, chrání každý soubor ve sdílené knihovně." FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding SharedLibraryErrorMessage}" IsVisible="{Binding HasSharedLibraryError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
                    <Label Text="✓ Toto zařízení má klíč sdílené knihovny." FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding HasSharedLibraryKey}" />

                    <Button Text="Vygenerovat nový klíč" Command="{Binding GenerateSharedLibraryKeyCommand}" IsVisible="{Binding HasNoSharedLibraryKey}" />
                    <Button Text="Zobrazit klíč" Style="{StaticResource SecondaryButton}" Command="{Binding ShowSharedLibraryKeyCommand}" IsVisible="{Binding HasSharedLibraryKey}" />
                    <Editor Text="{Binding SharedLibraryKeyBlob}" IsReadOnly="True" HeightRequest="60" IsVisible="{Binding HasSharedLibraryKeyBlob}" />
                    <Button Text="Kopírovat" Style="{StaticResource SecondaryButton}" Command="{Binding CopySharedLibraryKeyCommand}" IsVisible="{Binding HasSharedLibraryKeyBlob}" />

                    <Entry Text="{Binding SharedLibraryKeyImportText}" Placeholder="Vložte klíč, který vygeneroval někdo jiný" />
                    <Button Text="Importovat" Style="{StaticResource SecondaryButton}" Command="{Binding ImportSharedLibraryKeyCommand}" />

                    <!-- Key distribution is fully automatic (2026-09-11) — the app pushes the key to
                         paired peers and keyless peers pull it, with no user action. This label is
                         passive confirmation the app did it, not a control to operate. -->
                    <Label Text="{Binding SharedLibraryBroadcastStatusText}" FontSize="12" TextColor="Gray" IsVisible="{Binding HasSharedLibraryBroadcastStatus}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Shared diagnostics log (2026-09-10) — deliberately NOT gated behind IsAdmin/the admin
                 secret, unlike the two Admin cards above: any device can report to it and any device
                 can read it, no admin password needed each time (same reasoning /directory/members
                 and /library/files already apply). The whole point is being able to see what's going
                 wrong across every device in the community from just this one screen. -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Diagnostický log" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Sdílené chybové/varovné hlášení ze všech zařízení v komunitě." FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding DiagnosticLogErrorMessage}" IsVisible="{Binding HasDiagnosticLogError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="1" Text="⟳ Obnovit" Style="{StaticResource SecondaryButton}" Command="{Binding LoadDiagnosticLogCommand}" />
                    </Grid>
                    <controls:DelayedActivityIndicator IsBusy="{Binding IsLoadingDiagnosticLog}" HorizontalOptions="Center" />

                    <Label Text="Žádné záznamy." FontSize="12" TextColor="Gray" IsVisible="{Binding HasNoDiagnosticLogEntries}" />

                    <CollectionView ItemsSource="{Binding DiagnosticLogEntries}" IsVisible="{Binding HasDiagnosticLogEntries}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiagnosticLogItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="{Binding Level}" FontAttributes="Bold" FontSize="11.5">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="Info">
                                                        <Setter Property="TextColor" Value="Gray" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding DeviceDisplayName}" FontAttributes="Bold" FontSize="12.5" />
                                            <Label Grid.Column="2" Text="{Binding TimeText}" FontSize="11" TextColor="Gray" />
                                        </Grid>
                                        <Label Text="{Binding Message}" FontSize="12.5" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Context}" FontSize="10.5" FontFamily="Courier" TextColor="Gray" IsVisible="{Binding HasContext}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
