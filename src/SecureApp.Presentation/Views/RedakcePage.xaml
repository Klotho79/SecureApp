<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.RedakcePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:RedakceViewModel"
    Title="Redakce"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="RedakceMenuButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </ContentPage.Resources>

    <!-- 2026-10-26 (user: "v redakci budou jen tlačítka otevírající okna… tlačítko s příslušným názvem je
         přehlednější"): one button per action, each gated by the same permission its card always had; the
         former inline cards open in RedakceSectionPage, the rest go straight to their existing pages. -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Redakce" Style="{StaticResource PageTitle}" />

            <Label Text="Nemáte žádná oprávnění k úpravám." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoEditorialAccess}" HorizontalOptions="Center" Margin="0,20" />

            <Button Text="📢 Zpráva na nástěnku" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanPostToBoard}"
                    Command="{Binding OpenSectionCommand}" CommandParameter="board" />
            <Button Text="🚦 Možné stavy sálů" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanManageRoomStatusOptions}"
                    Command="{Binding OpenSectionCommand}" CommandParameter="roomstatus" />
            <Button Text="🗒 Možné poznámky k sálům" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanManageRoomStatusOptions}"
                    Command="{Binding OpenSectionCommand}" CommandParameter="roomnotes" />
            <Button Text="📓 Správa Logbooku" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanManageLogbook}"
                    Command="{Binding OpenLogbookManageCommand}" />
            <Button Text="📝 Nový výukový dokument" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanAuthorCms}"
                    Command="{Binding OpenCmsEditorCommand}" />
            <Button Text="✏ Moje zadání" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding HasMyAssignments}"
                    Command="{Binding OpenSectionCommand}" CommandParameter="myassignments" />
            <Button Text="👥 Zadání dokumentů" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanAssignCms}"
                    Command="{Binding OpenSectionCommand}" CommandParameter="cmsassign" />
            <Button Text="🗃 Rozpracované dokumenty" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanSeeInProgressDocuments}"
                    Command="{Binding OpenInProgressDocumentsCommand}" />
            <Button Text="📋 Poznámky ke schválení" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanAssignCms}"
                    Command="{Binding OpenCmsAnnotationQueueCommand}" />
            <Button Text="📚 Obsah knihovny (nahrát, koncepty, schvalování)" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanManageLibrary}"
                    Command="{Binding OpenLibraryManageCommand}" />
            <Button Text="🗂 Kategorie knihovny" Style="{StaticResource RedakceMenuButton}" IsVisible="{Binding CanManageLibrary}"
                    Command="{Binding OpenSectionCommand}" CommandParameter="library" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
