<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.AddAssignmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:AddAssignmentViewModel"
    Title="Směna"
    x:Name="PageRoot">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="{Binding DateText}" Style="{StaticResource PageTitle}" FontSize="15" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />

            <Label Text="Typ" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedTypeOption}" ItemDisplayBinding="{Binding Label}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Grid.Column="0" Text="Má konkrétní čas" VerticalOptions="Center" FontAttributes="Bold" />
                <Switch Grid.Column="1" IsToggled="{Binding HasSpecificTime}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasSpecificTime}">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Od" FontSize="9.5" TextColor="Gray" />
                    <TimePicker Time="{Binding StartTime}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Do" FontSize="9.5" TextColor="Gray" />
                    <TimePicker Time="{Binding EndTime}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Pracoviště" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry Text="{Binding WorkplaceName}" Placeholder="Nepovinné, např. Operační sál 7" />

            <FlexLayout IsVisible="{Binding HasWorkplaceSuggestions}" BindableLayout.ItemsSource="{Binding WorkplaceSuggestions}" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource Chip}" Margin="0,2,6,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PickSuggestionCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding .}" Style="{StaticResource ChipLabel}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="Poznámka" FontAttributes="Bold" Margin="0,8,0,0" />
            <Editor Text="{Binding Note}" Placeholder="Nepovinné" HeightRequest="70" />

            <Button Text="Uložit" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Margin="0,12,0,0" />
            <Button Text="Smazat směnu" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExistingAssignment}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" BorderColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
