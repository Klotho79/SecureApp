<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:LibraryViewModel"
    Title="Knihovna"
    Shell.NavBarIsVisible="False">
    <!-- Shell.NavBarIsVisible="False" (2026-09-20, "sjednot grafiku jako je ta nastenka") — this page
         already draws its own big title below (the PageTitle Label), so the native Shell chrome was a
         genuinely redundant second "Knihovna" header stacked above it. Same pattern Nástěnka/Chaty/
         Kontakty already use for the same reason. -->


    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="14">

        <!-- Header + search + filters, all in one scroll-independent block so the results list
             below gets its own scroll region (RefreshView needs sole ownership of the ScrollView
             it wraps — see Grid.Row 2). -->
        <VerticalStackLayout Grid.Row="0" Spacing="14">
            <VerticalStackLayout Spacing="2">
                <Label Text="Knihovna postupů" Style="{StaticResource PageTitle}" />
                <Label Text="Sdílená, šifrovaná příručka pro celý tým — prohledávatelná podle názvu, složky nebo štítku." FontSize="12.5" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <!-- Search + category — reworked 2026-09-06 from a custom search card + horizontal
                 chip/pill row to plain native controls (SearchBar, Picker). The user's own call:
                 this is a professional reference tool for clinicians, not a consumer app, so it
                 should look and behave like ordinary platform-native filter controls rather than
                 a styled "commercial app" search box and colored bubbles — a Picker also sidesteps
                 the chip row's real layout bug, where the horizontal ScrollView wrapping it could
                 visually overlap the field below it (especially cramped on a phone). -->
            <SearchBar Text="{Binding SearchQuery}" Placeholder="Hledat postupy, např. &quot;sepse&quot;…" SearchCommand="{Binding SearchCommand}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Kategorie" VerticalOptions="Center" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Picker Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
            </Grid>

            <Entry Text="{Binding TagFilter}" Placeholder="Filtrovat podle štítku" />

            <Label
                Text="{Binding StatusErrorMessage}"
                IsVisible="{Binding HasStatusError}"
                TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- Upload — kept as its own compact card rather than folded into the search card above,
             so "find a procedure" and "add a procedure" read as two clearly separate actions. -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0" IsVisible="{Binding CanModifyContent}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Přidat postup" Style="{StaticResource SectionHeader}" Margin="0" FontSize="14" />
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding UploadFolderPath}" Placeholder="Složka (volitelné)" />
                    <Entry Grid.Column="1" Text="{Binding UploadTags}" Placeholder="Štítky, oddělené čárkou" />
                    <Button Grid.Column="2" Text="⬆ Nahrát" Style="{StaticResource SecondaryButton}" Command="{Binding UploadCommand}" IsEnabled="{Binding CanUpload}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsLoading}" Command="{Binding SearchCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Nenalezeny žádné postupy — zkuste jiné hledání, nebo jeden přidejte výše."
                        IsVisible="{Binding IsEmpty}"
                        Margin="0,32"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <CollectionView
                        x:Name="ResultsView"
                        ItemsSource="{Binding Results}"
                        SelectionMode="Single"
                        SelectionChanged="OnResultSelected">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryFileItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                                        <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" Padding="0" StrokeShape="RoundRectangle 9" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Start">
                                            <Label Text="📄" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                                            <Label Text="{Binding FileName}" FontSize="14.5" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding FolderPath}" IsVisible="{Binding HasFolder}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />

                                            <FlexLayout IsVisible="{Binding HasTags}" BindableLayout.ItemsSource="{Binding Tags}" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LibraryTagItem">
                                                        <Border Style="{StaticResource Chip}" Margin="0,2,6,0">
                                                            <Label Text="{Binding Label}" Style="{StaticResource ChipLabel}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>

                                            <Label Text="{Binding SizeAndDateText}" FontSize="11.5" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
