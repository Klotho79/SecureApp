<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:LibraryViewModel"
    Title="Knihovna"
    Shell.NavBarIsVisible="False">
    <!-- Shell.NavBarIsVisible="False" (2026-09-20, "sjednot grafiku jako je ta nastenka") — this page
         already draws its own big title below (the PageTitle Label), so the native Shell chrome was a
         genuinely redundant second "Knihovna" header stacked above it. Same pattern Nástěnka/Chaty/
         Kontakty already use for the same reason. -->


    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="14">

        <!-- Header + search + filters, all in one scroll-independent block so the results list
             below gets its own scroll region (RefreshView needs sole ownership of the ScrollView
             it wraps — see Grid.Row 2). -->
        <VerticalStackLayout Grid.Row="0" Spacing="14">
            <!-- 2026-10-02: dropped the page's own "Knihovna postupů" title + description — the
                 Soubory tab's own menu (Knihovna/Dokumenty) already says which section this is;
                 repeating it as a second in-page heading was pure redundancy, per the user's own
                 catch. The "✏ Spravovat" button that used to sit here moved to Settings →
                 Systém → "Kategorie knihovny", finishing the "veškerá správa do nastavení"
                 consolidation the user asked for earlier. -->

            <SearchBar Text="{Binding SearchQuery}" Placeholder="Hledat postupy, např. &quot;sepse&quot;…" SearchCommand="{Binding SearchCommand}" />

            <!-- Category tiles (2026-10-02 redesign, replaces the 2026-09-06 Picker) — icon + name,
                 tap to filter. 2026-10-02 correction: one horizontally-scrolling row instead of a
                 wrapping grid, per the user's own ask ("jen jeden posunovací řádek"). Enlarged same
                 day, 2nd pass — user's own ask ("obtizne se trefuje... napisy... zalomene"): bigger
                 padding/tile for an easier tap target, WordWrap (2 lines) instead of truncating
                 longer names like "Doporučení"/"Resuscitace". -->
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CategoryChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChipItem">
                            <Border Padding="14,10" Margin="0,0,10,0" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=SelectCategoryCommand}" CommandParameter="{Binding Name}" />
                                </Border.GestureRecognizers>
                                <!-- FontAutoScalingEnabled="False" on both labels (2026-10-05, user's own
                                     report: wraps letter-by-letter on some phones, fine on others — e.g.
                                     Petr Faltus's device) — a plain MAUI Label scales with the DEVICE's
                                     own system accessibility font-size setting by default, completely
                                     separate from this app's own in-app "Velikost písma" slider. The
                                     92px/88px WidthRequest budgets measured live on 2026-10-03 only
                                     accounted for minor cross-device font-METRIC variance, not a whole
                                     accessibility-scale multiplier — fixing the rendered size instead of
                                     padding the width budget removes the actual source of variance. -->
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" WidthRequest="88">
                                    <Label Text="{Binding Icon}" FontSize="24" FontAutoScalingEnabled="False" HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}" FontSize="11" FontAutoScalingEnabled="False" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- "QUICK ACCESS: ACUTE STATES" z referenčního mockupu (2026-10-02) — pevná řada zkratek
                 pod kategoriemi, ťuknutí jen spustí fulltextové hledání daného stavu napříč celou
                 knihovnou (viz LibraryViewModel.AcuteStates). Stejný dlaždicový vzor jako kategorie
                 nad tím (2026-10-03, user's own ask) — pevná šířka + WordWrap namísto jednořádkové
                 bubliny, jen užší, protože tu žádná ikona nad textem není. 2026-10-03, 2nd pass:
                 nadpis nad řádkem + červený text na červeném pozadí nahrazen běžnou barvou textu
                 (jen pozadí zůstává červeně tónované jako vizuální odlišení, ne text i pozadí). -->
            <Label Text="Akutní stavy" FontSize="10.5" FontAttributes="Bold" />
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding AcuteStates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Padding="8,8" Margin="0,0,8,0" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=SearchAcuteStateCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <!-- WidthRequest=92 (2026-10-03, measured live: the single longest
                                     unbreakable word here, "Bronchospazmus"/"Laryngospazmus" at
                                     FontSize 9.5 Bold, renders ~78-80px wide on one line — below 72px
                                     WordWrap had no space to break on within that single word and fell
                                     back to splitting it mid-letter on at least one device. 92px gives
                                     margin for cross-device font-metric variance while staying well
                                     above every OTHER individual word's own width in the multi-word
                                     entries (~50-60px), so those still always wrap at a real space,
                                     never mid-word. -->
                                <!-- FontAutoScalingEnabled="False" (2026-10-05, same fix/reasoning as the
                                     category chips above — this label's own fixed-width mid-word-split
                                     bug was measured and fixed once already on 2026-10-03, but that fix
                                     didn't account for the device's OWN accessibility font-scale
                                     setting, a much larger source of cross-device variance). -->
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="92">
                                    <Label Text="{Binding .}" FontSize="9.5" FontAttributes="Bold" FontAutoScalingEnabled="False"
                                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label
                Text="{Binding StatusErrorMessage}"
                IsVisible="{Binding HasStatusError}"
                TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding SearchCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <!-- 2026-10-02: the browse page's default content is sub-category cards, not a
                         flat file list ("dole jsou soubory ty tam nechci, tam maji byt dalsi
                         polozky") — a file list only comes back while actively text-searching, since
                         search needs to look across every file regardless of sub-category.
                         Browse-only here — adding/removing sub-categories moved to Settings ("sprava
                         a pridavani kategorii ma byt v nastaveni"), matching the user's own ask to
                         consolidate all library management there, same as upload/review already are
                         via "✏ Spravovat". -->

                    <Label
                        Text="Vyberte kategorii nahoře."
                        IsVisible="{Binding IsNoTopCategorySelected}"
                        Margin="0,32"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsTopCategorySelected}">

                        <!-- Vestavěné nástroje appky (2026-10-03) — klientský výpočet, žádný relay/
                             knihovna; vidí jen "Nástroje" (viz LibraryViewModel.ShowNastrojeTools).
                             Seznam (viz LibraryViewModel.NastrojeTools), ne jedna pevná karta — od
                             druhého nástroje (Murray score) vedle GCS. -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowNastrojeTools}" BindableLayout.ItemsSource="{Binding NastrojeTools}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:NastrojeToolItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                            <Label Grid.Column="2" Text="›" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <CollectionView ItemsSource="{Binding Subcategories}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SubcategoryItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenSubcategoryCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>

                    <!-- Search mode — a plain cross-category file list, icon + title + chevron row. -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSearching}">

                        <Label
                            Text="Nenalezeny žádné postupy."
                            IsVisible="{Binding IsEmpty}"
                            Margin="0,32"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                        <CollectionView
                            x:Name="ResultsView"
                            ItemsSource="{Binding Results}"
                            SelectionMode="Single"
                            SelectionChanged="OnResultSelected">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryFileItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0" Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                                            <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" Padding="0" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Center">
                                                <Label Text="📄" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding FileName}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding FolderPath}" IsVisible="{Binding HasFolder}" FontSize="9" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding SizeAndDateText}" FontSize="8.5" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2" Text="🗑" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" Padding="4,0" VerticalOptions="Center"
                                                    IsVisible="{Binding IsMine}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=DeleteCommand}"
                                                    CommandParameter="{Binding .}" />

                                            <Label Grid.Column="3" Text="›" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
