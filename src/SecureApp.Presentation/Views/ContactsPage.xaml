<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:contacts="clr-namespace:SecureApp.Presentation.Contacts"
    x:DataType="vm:ContactsViewModel"
    Title="Kontakty"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Kontakty" Style="{StaticResource PageTitle}" />

            <!-- Rychlé kontakty first — "kam volat při komplikacích" is exactly the thing you need
                 fast in a real situation, so it leads rather than the much longer extension list
                 below it (2026-09-10, transcribed from the reference logbook PDF). -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Rychlé kontakty" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Kam volat v případě komplikací s…" FontSize="12" TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding QuickContacts}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="contacts:QuickContactEntry">
                                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Situation}" FontSize="13.5" FontAttributes="Bold" />
                                        <!-- Klapky zvýrazněné stejně jako v telefonním seznamu (2026-09-10, user's own
                                             ask) — FormattedAnswer je předpočítaný FormattedString přímo na
                                             QuickContactEntry, ne XAML converter (viz jeho vlastní poznámky). -->
                                        <Label FormattedText="{Binding FormattedAnswer}" FontSize="12.5" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Telefonní seznam" Style="{StaticResource SectionHeader}" Margin="0" />

                    <SearchBar Text="{Binding SearchQuery}" Placeholder="Hledat jméno, oddělení nebo klapku…" />

                    <Label Text="Nic nenalezeno." FontSize="12" TextColor="Gray" IsVisible="{Binding HasNoResults}" />

                    <!-- Sbalitelné sekce (2026-09-10 — "je to pěkně pomalé... rozděl to ať se toho
                         tolik nenačítá"): ~130 řádků najednou v jednom flat seznamu bylo znatelně
                         pomalé. Stejný vzor jako u rozbalovací statistiky v Logbooku — sbaleno ve
                         výchozím stavu, řádky dané sekce se vykreslí, až když na ni ťuknete.
                         Hledání sekce s výsledkem automaticky rozbalí (viz ApplyFilter). -->
                    <CollectionView ItemsSource="{Binding PhoneSections}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactSectionGroup">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0" Text="{Binding Name, StringFormat='{0} ▾'}" FontSize="13.5" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                                    <Setter Property="Text" Value="{Binding Name, StringFormat='{0} ▸'}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Grid.Column="1" Text="{Binding Count}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout Spacing="2" IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding Entries}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="contacts:PhoneDirectoryEntry">
                                                <Grid Padding="4,5,0,5" ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="13.5" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="{Binding Number, StringFormat='kl. {0}'}" FontSize="14.5" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
