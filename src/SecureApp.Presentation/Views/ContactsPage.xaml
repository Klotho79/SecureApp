<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:contacts="clr-namespace:SecureApp.Presentation.Contacts"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:ContactsViewModel"
    Title="Kontakty"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Kontakty" Style="{StaticResource PageTitle}" />

            <!-- Firemní kontakty (2026-09-20) — sdílený, celofiremní telefonní seznam (klapky), stejný
                 pro každého, synchronizovaný přes relay (ISharedContactService). Žádná vazba na chat
                 — jsou to podnikové telefonní kontakty. Přetažení na PC přes DragGestureRecognizer/
                 DropGestureRecognizer (nativní MAUI) — viz ContactsPage.xaml.cs a ContactsViewModel.ReorderAsync. -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Firemní kontakty" Style="{StaticResource SectionHeader}" Margin="0" />
                        <Button Grid.Column="1" Text="➕" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding AddContactCommand}" />
                    </Grid>
                    <Label Text="Sdílený seznam pro celou komunitu — změna se projeví u všech. Na PC můžete pořadí měnit přetažením." FontSize="9.5" TextColor="Gray" />
                    <Label Text="{Binding CompanyContactsErrorMessage}" IsVisible="{Binding HasCompanyContactsError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
                    <controls:DelayedActivityIndicator IsBusy="{Binding IsLoadingCompanyContacts}" HorizontalOptions="Center" />
                    <Label Text="Zatím žádné kontakty." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoCompanyContacts}" />

                    <!-- CollectionView, not BindableLayout (2026-09-29 — see the ARIM section below's
                         own remarks: BindableLayout builds every row up front with no virtualization,
                         fine for a short list today but the same trap this list would eventually walk
                         into too as it grows). -->
                    <CollectionView ItemsSource="{Binding CompanyContacts}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SharedContactItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <Border.GestureRecognizers>
                                        <DragGestureRecognizer CanDrag="True" DragStarting="OnContactDragStarting" />
                                        <DropGestureRecognizer AllowDrop="True" Drop="OnContactDrop" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding DisplayName}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Subtitle}" FontSize="9" TextColor="Gray" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <!-- Only for a complete number (mob./tel.), never a bare extension. -->
                                        <Button Grid.Column="1" Text="📞" BackgroundColor="Transparent" Padding="6,0" IsVisible="{Binding CanCall}" Command="{Binding CallCommand}" CommandParameter="{Binding Phone}" />
                                        <Button Grid.Column="2" Text="🗑" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" Padding="6,0" Command="{Binding DeleteCommand}" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Soukromé kontakty ARIM (2026-09-29, user's own correction: this MUST be its own
                 collapsible section, not folded into "Firemní kontakty" — same shape/behavior (call,
                 delete), just its own card, collapsed by default since the list (the whole ARIM
                 WhatsApp group, imported from xlsx) is 71 rows long. A CollectionView here (not
                 BindableLayout — see this file's own remarks on the "Telefonní seznam" section below
                 for why BindableLayout alone still isn't enough at this size), so expanding it actually
                 virtualizes/recycles rows instead of building all 71 heavy per-row views the instant
                 IsExpanded flips true (2026-09-29, user hit exactly this: "otevření těch 71 kontaktů
                 trvá pekelně dlouho"). 2026-09-30, user's own ask: Czech-alphabetical order + search
                 (ArimSearchQuery/ApplyArimFilter) — no drag-reorder handle here any more, since a
                 manual order would just get overwritten by the very next alphabetical re-sort; only
                 Firemní kontakty above still supports it. -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding ArimContactsGroup.HasEntries}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ArimContactsGroup.ToggleExpandedCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="{Binding ArimContactsGroup.Name, StringFormat='{0} ▾'}" Style="{StaticResource SectionHeader}" Margin="0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ArimContactsGroup.IsExpanded}" Value="False">
                                    <Setter Property="Text" Value="{Binding ArimContactsGroup.Name, StringFormat='{0} ▸'}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="1" Text="{Binding ArimContactsGroup.Count}" FontSize="9.5" TextColor="Gray" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Sdílený seznam pro celou komunitu — změna se projeví u všech." FontSize="9.5" TextColor="Gray" />
                    <SearchBar Text="{Binding ArimSearchQuery}" Placeholder="Hledat jméno nebo číslo…" />

                    <CollectionView ItemsSource="{Binding ArimContactsGroup.VisibleEntries}" IsVisible="{Binding ArimContactsGroup.IsExpanded}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SharedContactItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding DisplayName}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Subtitle}" FontSize="9" TextColor="Gray" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <!-- Only for a complete number (mob./tel.), never a bare extension. -->
                                        <Button Grid.Column="1" Text="📞" BackgroundColor="Transparent" Padding="6,0" IsVisible="{Binding CanCall}" Command="{Binding CallCommand}" CommandParameter="{Binding Phone}" />
                                        <Button Grid.Column="2" Text="🗑" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" Padding="6,0" Command="{Binding DeleteCommand}" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Rychlé kontakty first — "kam volat při komplikacích" is exactly the thing you need
                 fast in a real situation, so it leads rather than the much longer extension list
                 below it (2026-09-10, transcribed from the reference logbook PDF). -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Rychlé kontakty" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Kam volat v případě komplikací s…" FontSize="9.5" TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding QuickContacts}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="contacts:QuickContactEntry">
                                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Situation}" FontSize="11" FontAttributes="Bold" />
                                        <!-- Klapky zvýrazněné stejně jako v telefonním seznamu (2026-09-10, user's own
                                             ask) — FormattedAnswer je předpočítaný FormattedString přímo na
                                             QuickContactEntry, ne XAML converter (viz jeho vlastní poznámky). -->
                                        <Label FormattedText="{Binding FormattedAnswer}" FontSize="10" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Telefonní seznam" Style="{StaticResource SectionHeader}" Margin="0" />

                    <SearchBar Text="{Binding SearchQuery}" Placeholder="Hledat jméno, oddělení nebo klapku…" />

                    <Label Text="Nic nenalezeno." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoResults}" />

                    <!-- Sbalitelné sekce (2026-09-10 — "je to pěkně pomalé... rozděl to ať se toho
                         tolik nenačítá"): ~130 řádků najednou v jednom flat seznamu bylo znatelně
                         pomalé. Stejný vzor jako u rozbalovací statistiky v Logbooku — sbaleno ve
                         výchozím stavu, řádky dané sekce se vykreslí, až když na ni ťuknete.
                         Hledání sekce s výsledkem automaticky rozbalí (viz ApplyFilter).
                         Pozor: BindableLayout níže NEVIRTUALIZUJE — bind je záměrně na
                         ContactSectionGroup.VisibleEntries (prázdné, dokud IsExpanded), ne přímo na
                         Entries, jinak se všech ~130 řádků reálně postaví hned při načtení stránky
                         bez ohledu na sbalení (2026-09-16, viz VisibleEntries's own remarks). -->
                    <CollectionView ItemsSource="{Binding PhoneSections}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactSectionGroup">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0" Text="{Binding Name, StringFormat='{0} ▾'}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                                    <Setter Property="Text" Value="{Binding Name, StringFormat='{0} ▸'}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Grid.Column="1" Text="{Binding Count}" FontSize="9.5" TextColor="Gray" VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout Spacing="2" IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding VisibleEntries}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="contacts:PhoneDirectoryEntry">
                                                <Grid Padding="4,5,0,5" ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="11" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="{Binding NumberLabel}" FontSize="11.5" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                                        <!-- Tap dials a complete number; a bare extension is a no-op (CallCommand ignores it). -->
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ContactsViewModel}}, Path=CallCommand}" CommandParameter="{Binding Number}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
