<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.ChatListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:ChatListViewModel"
    Title="Chaty">

    <!-- Adaptive list+detail split (2026-09-06) — on a wide window (tablet/desktop) the list stays
         on screen and tapping a chat fills DetailPane in place; on a narrow one (phone) DetailColumn
         collapses to 0 and tapping a chat pushes ChatPage instead, same as before. Built this way
         specifically because Windows' Shell back button doesn't reliably return from a pushed
         ChatPage to this list (works fine on Android) — see ChatThreadView's own remarks. Widths
         are toggled from code-behind's SizeChanged handler, not a XAML trigger — MAUI has no
         window-width VisualState trigger, only per-page/OS idioms this app doesn't otherwise use. -->
    <Grid x:Name="RootGrid" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowDefinitions="Auto,*" Padding="20,16" RowSpacing="14">

            <VerticalStackLayout Grid.Row="0" Spacing="12">
                <Label Text="Chaty" Style="{StaticResource PageTitle}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="+ Nový chat" Command="{Binding NewChatCommand}" />
                    <Button Grid.Column="1" Text="+ Nová skupina" Style="{StaticResource SecondaryButton}" Command="{Binding NewGroupCommand}" />
                </Grid>
            </VerticalStackLayout>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
                <ScrollView>
                    <VerticalStackLayout Spacing="14">

                        <!-- Group chats (2026-09-07) — a full mesh of ordinary pairwise sessions
                             under the hood, see GroupChat's own remarks; listed separately from
                             1:1 Sessions below since the two item shapes genuinely differ (a group
                             has no single peer, just a member count/name). Kept as simple push
                             navigation (OnGroupSelected) rather than folded into the adaptive
                             list+detail split below — a scope call for this first pass, not a
                             XAML limitation. -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasGroups}">
                            <Label Text="Skupiny" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <CollectionView
                                x:Name="GroupsView"
                                ItemsSource="{Binding Groups}"
                                SelectionMode="Single"
                                SelectionChanged="OnGroupSelected">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GroupChatListItem">
                                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" Padding="0" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Center">
                                                    <Label Text="{Binding Initials}" FontFamily="SpectralSemibold" FontSize="12.5" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                                <!-- Delete from THIS device's list only — see ChatListViewModel.DeleteGroupAsync's own remarks; distinct from "leave" (GroupChatPage's own 🚪 Opustit), which actually notifies the group. -->
                                                <Button Grid.Column="2" Text="🗑" FontSize="13" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0" VerticalOptions="Center" Clicked="OnDeleteGroupClicked" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <Label
                            Text="Zatím žádné chaty. Klepnutím na '+ Nový chat' jeden založte."
                            IsVisible="{Binding IsEmpty}"
                            Margin="0,32"
                            HorizontalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                        <CollectionView
                            x:Name="SessionsView"
                            ItemsSource="{Binding Sessions}"
                            SelectionMode="Single"
                            SelectionChanged="OnSessionSelected">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatSessionItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" Padding="0" StrokeShape="RoundRectangle 17" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Center">
                                                <Label Text="{Binding Initials}" FontFamily="SpectralSemibold" FontSize="12.5" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding PeerDisplayName}" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding LastActivityText}" FontSize="11.5" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <!-- Reset/re-pair (2026-09-07) — recovery path for a session whose ratchet state has
                                                 become genuinely undecryptable, see ChatListViewModel.ResetSessionAsync's own remarks. -->
                                            <Button Grid.Column="2" Text="↺" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0" VerticalOptions="Center" Clicked="OnResetSessionClicked" />
                                            <!-- Delete from THIS device's list only (2026-09-10) — see ChatListViewModel.DeleteSessionAsync's own remarks. -->
                                            <Button Grid.Column="3" Text="🗑" FontSize="13" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0" VerticalOptions="Center" Clicked="OnDeleteSessionClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>

        <BoxView Grid.Column="1" WidthRequest="1" HorizontalOptions="Start" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

        <Grid Grid.Column="1" x:Name="DetailPane" Padding="1,0,0,0" IsVisible="False">
            <ContentView x:Name="ThreadHost" IsVisible="False" />
            <VerticalStackLayout x:Name="EmptyDetailState" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                <Label Text="Vyberte chat" FontFamily="SpectralSemibold" FontSize="17" HorizontalOptions="Center" />
                <Label Text="Vyberte konverzaci ze seznamu a začněte číst." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
