<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.ChatListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:ChatListViewModel"
    Title="Chaty"
    Shell.NavBarIsVisible="False">

    <!-- Shell.NavBarIsVisible="False" (2026-09-16, user's own ask) — this page already draws its own
         "Chaty" title in-content (the PageTitle Label below) and the phone overlay draws its own
         "‹ Zpět" row, so Shell's own chrome ("Chaty" + nothing else, since this page is never pushed)
         was a genuinely redundant second bar sitting above whichever of those was showing. Same
         pattern ContactsPage/LogbookPage already use for the same reason. -->

    <!-- Outer Grid (2026-09-13): holds the list/detail split AND a full-screen persistent thread
         overlay for phones. The overlay hosts ONE reused ChatThreadView (see code-behind's view cache)
         that is shown/hidden instead of a page being pushed/popped — so reopening a chat does NOT
         rebuild + re-render the whole page every time (the measured ~74ms MAUI render floor). This is
         exactly why the chat LIST is fast: a persistent tab that's only shown/hidden, never rebuilt. -->
    <Grid>

    <!-- Adaptive list+detail split (2026-09-06) — on a wide window (tablet/desktop) the list stays
         on screen and tapping a chat fills DetailPane in place; on a narrow one (phone) DetailColumn
         collapses to 0. Widths are toggled from code-behind's SizeChanged handler. -->
    <Grid x:Name="RootGrid" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowDefinitions="Auto,*" Padding="16" RowSpacing="14">

            <VerticalStackLayout Grid.Row="0" Spacing="12">
                <Label Text="Chaty" Style="{StaticResource PageTitle}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="+ Nový chat" Command="{Binding NewChatCommand}" />
                    <Button Grid.Column="1" Text="+ Nová skupina" Style="{StaticResource SecondaryButton}" Command="{Binding NewGroupCommand}" />
                </Grid>
            </VerticalStackLayout>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <ScrollView>
                    <VerticalStackLayout Spacing="14">

                        <!-- Consent banner (2.2, 2026-09-14): pairing invites from peers the user
                             previously removed — held here for explicit accept/decline instead of
                             silently re-appearing. See RemovedPeersStore / PendingInvitesStore. -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPendingInvites}">
                            <Label Text="Žádosti o opětovné přidání" FontAttributes="Bold" FontSize="10.5" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding PendingInvites}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PendingInviteItem">
                                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" VerticalOptions="Center" LineBreakMode="TailTruncation" Text="{Binding InitiatorDisplayName, StringFormat='{0} vás chce znovu přidat'}" />
                                                <Button Grid.Column="1" Text="Přijmout" WidthRequest="90" Padding="0"
                                                        Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.AcceptInviteCommand}" CommandParameter="{Binding .}" />
                                                <Button Grid.Column="2" Text="Odmítnout" Style="{StaticResource SecondaryButton}" WidthRequest="96" Padding="0"
                                                        Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.DeclineInviteCommand}" CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Group chats (2026-09-07) — a full mesh of ordinary pairwise sessions
                             under the hood, see GroupChat's own remarks; listed separately from
                             1:1 Sessions below since the two item shapes genuinely differ (a group
                             has no single peer, just a member count/name). Kept as simple push
                             navigation (OnGroupSelected) rather than folded into the adaptive
                             list+detail split below — a scope call for this first pass, not a
                             XAML limitation. -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasGroups}">
                            <Label Text="Skupiny" FontAttributes="Bold" FontSize="10.5" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <CollectionView
                                x:Name="GroupsView"
                                ItemsSource="{Binding Groups}"
                                SelectionMode="Single"
                                SelectionChanged="OnGroupSelected">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GroupChatListItem">
                                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" Padding="0" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Center">
                                                    <Label Text="{Binding Initials}" FontFamily="SpectralSemibold" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                <!-- Delete from THIS device's list only — see ChatListViewModel.DeleteGroupAsync's own remarks; distinct from "leave" (GroupChatPage's own 🚪 Opustit), which actually notifies the group. -->
                                                <Button Grid.Column="2" Text="🗑" FontSize="10.5" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0" VerticalOptions="Center" Clicked="OnDeleteGroupClicked" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <Label
                            Text="Zatím žádné chaty. Klepnutím na '+ Nový chat' jeden založte."
                            IsVisible="{Binding IsEmpty}"
                            Margin="0,32"
                            HorizontalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                        <CollectionView
                            x:Name="SessionsView"
                            ItemsSource="{Binding Sessions}"
                            SelectionMode="Single"
                            SelectionChanged="OnSessionSelected">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatSessionItem">
                                    <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" Padding="0" StrokeShape="RoundRectangle 17" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Center">
                                                <Label Text="{Binding Initials}" FontFamily="SpectralSemibold" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding PeerDisplayName}" FontSize="11" FontAttributes="Bold" />
                                                <Label Text="{Binding LastActivityText}" FontSize="9" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" LineBreakMode="TailTruncation" />
                                                <!-- 2.1 (2026-09-17): peer absent from the relay's ACTIVE directory (stale/dead
                                                     registration) — paired with the same ↺ resync button every row already has. -->
                                                <Label Text="⚠ nedostupný — zkuste přepárovat" FontSize="8.5" IsVisible="{Binding IsUnavailable}"
                                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                            </VerticalStackLayout>
                                            <!-- Reset/re-pair (2026-09-07) — recovery path for a session whose ratchet state has
                                                 become genuinely undecryptable, see ChatListViewModel.ResetSessionAsync's own remarks. -->
                                            <Button Grid.Column="2" Text="↺" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0" VerticalOptions="Center" Clicked="OnResetSessionClicked" />
                                            <!-- Delete from THIS device's list only (2026-09-10) — see ChatListViewModel.DeleteSessionAsync's own remarks. -->
                                            <Button Grid.Column="3" Text="🗑" FontSize="10.5" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0" VerticalOptions="Center" Clicked="OnDeleteSessionClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Archive (2.3, 2026-09-14): chats/groups that lost all users, kept read-only.
                             Collapsed header (tap to expand); opening an item shows read-only history. -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasArchivedChats}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleArchiveCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding ArchivedCount, StringFormat='📦 Archiv ({0}) ▾'}" FontAttributes="Bold" FontSize="10.5" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsArchiveExpanded}" Value="False">
                                            <Setter Property="Text" Value="{Binding ArchivedCount, StringFormat='📦 Archiv ({0}) ▸'}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsArchiveExpanded}">
                                <CollectionView ItemsSource="{Binding ArchivedGroups}" SelectionMode="Single" SelectionChanged="OnGroupSelected">
                                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="6" /></CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GroupChatListItem">
                                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" Opacity="0.7">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="📦" FontSize="13" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <CollectionView ItemsSource="{Binding ArchivedSessions}" SelectionMode="Single" SelectionChanged="OnSessionSelected">
                                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="6" /></CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChatSessionItem">
                                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" Opacity="0.7">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="📦" FontSize="13" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding PeerDisplayName}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>

        <BoxView Grid.Column="1" WidthRequest="1" HorizontalOptions="Start" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

        <Grid Grid.Column="1" x:Name="DetailPane" Padding="1,0,0,0" IsVisible="False">
            <ContentView x:Name="ThreadHost" IsVisible="False" />
            <VerticalStackLayout x:Name="EmptyDetailState" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                <Label Text="Vyberte chat" FontFamily="SpectralSemibold" FontSize="13.5" HorizontalOptions="Center" />
                <Label Text="Vyberte konverzaci ze seznamu a začněte číst." FontSize="10.5" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

        <!-- Phone-only persistent thread overlay (2026-09-13). Covers the list full-screen when a chat
             is open; hosts a reused ChatThreadView/GroupChatThreadView so reopening is instant (no page
             rebuild). Its own back chevron hides it (see OnNarrowThreadBack) — hardware back is handled
             in code-behind. -->
        <Grid x:Name="NarrowThreadOverlay" IsVisible="False" RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="8,6" ColumnSpacing="6">
                <Button Grid.Column="0" Text="‹ Zpět" HorizontalOptions="Start" Style="{StaticResource SecondaryButton}" Clicked="OnNarrowThreadBack" />
                <!-- Group-only header extras (2026-09-16, user's own ask: Members/Add/Leave on the SAME
                     row as "‹ Zpět", not a row of their own). Hidden for a 1:1 thread; code-behind
                     (ShowNarrowGroup/ShowNarrowThread/HideNarrowThread) sets this Grid's BindingContext
                     to the hosted GroupChatViewModel and toggles IsVisible whenever what the overlay
                     hosts changes — GroupChatThreadView's OWN copy of these controls is hidden at the
                     same time (see its SetCompactHeaderHosted) so they show in exactly one place. -->
                <Grid x:Name="NarrowGroupHeaderExtras" x:DataType="vm:GroupChatViewModel" Grid.Column="1" IsVisible="False"
                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <Label Grid.Column="0" VerticalOptions="Center" HorizontalOptions="End" FontSize="10.5"
                           Text="{Binding MemberCount, StringFormat='Členové ({0}) ▸'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMembersExpandedCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Button Grid.Column="1" Text="➕" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0"
                            Command="{Binding ToggleAddMemberCommand}" IsVisible="{Binding CanManageMembers}" />
                    <Button Grid.Column="2" Text="🚪" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0"
                            Clicked="OnNarrowGroupLeaveClicked" />
                </Grid>
            </Grid>
            <ContentView Grid.Row="1" x:Name="NarrowThreadHost" />
        </Grid>

    </Grid>
</ContentPage>
