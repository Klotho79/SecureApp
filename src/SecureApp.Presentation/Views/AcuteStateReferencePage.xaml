<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.AcuteStateReferencePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:AcuteStateReferenceViewModel"
    Title="{Binding Term}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding Term}" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource CardBorder}" BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}">
                <Label
                    Text="Vestavěné obecné shrnutí z odborné literatury — NENÍ nahraný dokument tohoto pracoviště. Ověřte oproti aktuálním protokolům, než na tom postavíte klinické rozhodnutí."
                    FontSize="10"
                    FontAttributes="Bold" />
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Label Text="{Binding Content}" FontSize="12" LineBreakMode="WordWrap" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
