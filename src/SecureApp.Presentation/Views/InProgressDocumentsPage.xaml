<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.InProgressDocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:InProgressDocumentsViewModel"
    Title="Rozpracované dokumenty">

    <!-- Admin/Modifier overview of unfinished and waiting documents (2026-10-26). This page only lists and previews;
         approving or rejecting stays in "Ke schválení" (Redakce → Obsah knihovny). -->
    <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="10">

                <Label Text="{Binding ErrorText}" IsVisible="{Binding HasError}" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <Label Text="Žádné rozpracované ani čekající dokumenty." IsVisible="{Binding IsEmpty}" Margin="0,32"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:InProgressItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding AuthorName, StringFormat='Autor: {0}'}" FontSize="10" />
                                        <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                        <Label Text="{Binding UpdatedText}" FontSize="9" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="👁 Náhled" Style="{StaticResource SecondaryButton}" VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InProgressDocumentsViewModel}}, Path=OpenCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
