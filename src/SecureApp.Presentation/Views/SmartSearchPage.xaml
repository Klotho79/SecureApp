<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.SmartSearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:SmartSearchViewModel"
    Title="Hledat">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <SearchBar Text="{Binding SearchQuery}" Placeholder="Hledat oznámení, chat, skupinu, kontakt, rozpis…" />

            <controls:DelayedActivityIndicator IsBusy="{Binding IsSearching}" HorizontalOptions="Center" />
            <Label Text="Nic nenalezeno." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoResults}" HorizontalOptions="Center" Margin="0,20" />

            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasNotificationResults}">
                <Label Text="Oznámení" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding NotificationResults}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" FontSize="9.5" TextColor="Gray" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasChatResults}">
                <Label Text="Chaty" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding ChatResults}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" FontSize="9.5" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasGroupResults}">
                <Label Text="Skupiny" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding GroupResults}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" FontSize="9.5" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasContactResults}">
                <Label Text="Kontakty" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding ContactResults}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" FontSize="9.5" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Rozpis (2026-09-21, spec §11's own "vacation" example) — matches on the assignment
                 type's Czech label, the workplace name, or the note; within a bounded ±window, not
                 the whole schedule (see SmartSearchViewModel's own remarks). -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasWorkplaceResults}">
                <Label Text="Rozpis" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding WorkplaceResults}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" FontSize="9.5" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
