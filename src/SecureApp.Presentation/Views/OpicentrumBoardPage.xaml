<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.OpicentrumBoardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:OpicentrumBoardViewModel"
    Title="Opicentrum">

    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="8">

        <!-- Admin/Modifier only — see OpicentrumBoardViewModel's own remarks. -->
        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" VerticalOptions="Center" Padding="24" IsVisible="{Binding IsAccessDenied}">
            <Label Text="Tato stránka je dostupná jen pro Admin/Modifier." HorizontalTextAlignment="Center" FontSize="12" TextColor="Gray" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="0" Spacing="8" IsVisible="{Binding IsAccessGranted}">
            <!-- Sub-tabs — same Button+DataTrigger convention as SettingsViewModel's SystemSubTab. -->
            <FlexLayout Wrap="Wrap">
                <Button Text="Pozice" Style="{StaticResource SubTabButton}" Command="{Binding SelectSubTabCommand}" CommandParameter="0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsPositionsSubTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Volno" Style="{StaticResource SubTabButton}" Command="{Binding SelectSubTabCommand}" CommandParameter="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsVolnoSubTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </FlexLayout>
        </VerticalStackLayout>

        <!-- ============================ POZICE ============================ -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="6" IsVisible="{Binding IsPositionsSubTab}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <Label Grid.Column="0" Text="{Binding PositionsLastUpdatedText, StringFormat='Aktualizováno: {0}'}" FontSize="9" TextColor="Gray" VerticalOptions="Center" />
                <controls:DelayedActivityIndicator Grid.Column="1" IsBusy="{Binding IsPositionsRefreshing}" />
                <Button Grid.Column="2" Text="Obnovit" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="10,4" MinimumHeightRequest="30"
                        Command="{Binding RefreshPositionsCommand}" IsEnabled="{Binding CanRefreshPositions}" />
            </Grid>

            <Label Grid.Row="1" Text="{Binding PositionsErrorText}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" IsVisible="{Binding HasPositionsError}" LineBreakMode="WordWrap" />

            <controls:DelayedActivityIndicator Grid.Row="2" IsBusy="{Binding IsPositionsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Row="2" Text="Zatím žádná data — stiskněte Obnovit." FontSize="10" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasNoPositionsData}" />

            <!-- Pannable board — ScrollView(Both) gives the "window bigger than the display, can pan
                 around" the user asked for. 2026-10-24: drawn on canvases (PositionsBoardView) instead of
                 ~1 300 nested views (opening the page from Nástěnka took ~1 s). The body scrolls natively
                 and takes the chip taps; the names/header overlays are translated by OnPositionsScrolled so
                 they stay pinned, and the corner hides whatever scrolls under both. -->
            <Grid x:Name="PositionsBoard" Grid.Row="2" IsClippedToBounds="True" IsVisible="{Binding HasPositionsData}">
                <ScrollView x:Name="PositionsScroll" Orientation="Both" Scrolled="OnPositionsScrolled">
                    <controls:PositionsBoardView Layer="Body" Rows="{Binding PositionsRows}" DayHeaders="{Binding PositionsDayHeaders}"
                                                 HorizontalOptions="Start" VerticalOptions="Start" ChipTapped="OnPersonChipTapped" Drawn="OnPositionsDrawn" />
                </ScrollView>
                <controls:PositionsBoardView x:Name="PositionsNames" Layer="Names" Rows="{Binding PositionsRows}" DayHeaders="{Binding PositionsDayHeaders}"
                                             HorizontalOptions="Start" VerticalOptions="Start" InputTransparent="True" />
                <controls:PositionsBoardView x:Name="PositionsHeader" Layer="Header" Rows="{Binding PositionsRows}" DayHeaders="{Binding PositionsDayHeaders}"
                                             HorizontalOptions="Start" VerticalOptions="Start" InputTransparent="True" />
                <BoxView x:Name="PositionsCorner" WidthRequest="132" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Start" InputTransparent="True"
                         Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
            </Grid>
        </Grid>

        <!-- ============================ VOLNO ============================ -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="6" IsVisible="{Binding IsVolnoSubTab}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <Label Grid.Column="0" Text="{Binding VolnoLastUpdatedText, StringFormat='Aktualizováno: {0}'}" FontSize="9" TextColor="Gray" VerticalOptions="Center" />
                <controls:DelayedActivityIndicator Grid.Column="1" IsBusy="{Binding IsVolnoRefreshing}" />
                <Button Grid.Column="2" Text="Obnovit" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="10,4" MinimumHeightRequest="30"
                        Command="{Binding RefreshVolnoCommand}" IsEnabled="{Binding CanRefreshVolno}" />
            </Grid>

            <Label Grid.Row="1" Text="{Binding VolnoErrorText}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" IsVisible="{Binding HasVolnoError}" LineBreakMode="WordWrap" />

            <controls:DelayedActivityIndicator Grid.Row="2" IsBusy="{Binding IsVolnoLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Row="2" Text="Zatím žádná data — stiskněte Obnovit." FontSize="10" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasNoVolnoData}" />

            <!-- Read-only this round — see OpicentrumBoardViewModel.Volno.cs's own remarks. -->
            <!-- 2026-10-24: drawn on canvases (VolnoBoardView) instead of ~1 740 Labels. The body scrolls
                 natively inside the ScrollView; the names/header overlays are translated by OnVolnoScrolled
                 so they stay pinned, and the corner hides whatever scrolls under both. -->
            <Grid x:Name="VolnoBoard" Grid.Row="2" IsClippedToBounds="True" IsVisible="{Binding HasVolnoData}">
                <ScrollView x:Name="VolnoScroll" Orientation="Both" Scrolled="OnVolnoScrolled">
                    <controls:VolnoBoardView Layer="Body" Rows="{Binding VolnoRows}" DayHeaders="{Binding VolnoDayHeaders}"
                                             HorizontalOptions="Start" VerticalOptions="Start" />
                </ScrollView>
                <controls:VolnoBoardView x:Name="VolnoNames" Layer="Names" Rows="{Binding VolnoRows}" DayHeaders="{Binding VolnoDayHeaders}"
                                         HorizontalOptions="Start" VerticalOptions="Start" InputTransparent="True" />
                <controls:VolnoBoardView x:Name="VolnoHeader" Layer="Header" Rows="{Binding VolnoRows}" DayHeaders="{Binding VolnoDayHeaders}"
                                         HorizontalOptions="Start" VerticalOptions="Start" InputTransparent="True" />
                <BoxView x:Name="VolnoCorner" WidthRequest="132" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Start" InputTransparent="True"
                         Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
