<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.NewChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:NewChatViewModel"
    Title="Nový chat">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="{Binding StatusErrorMessage}" IsVisible="{Binding HasStatusError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
            <Label Text="{Binding StatusInfoMessage}" IsVisible="{Binding HasStatusInfo}" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" LineBreakMode="WordWrap" />
            <controls:DelayedActivityIndicator IsBusy="{Binding IsBusy}" HorizontalOptions="Center" />

            <!-- Member directory (2026-09-06) — the ONLY path now (2026-09-16, user's own ask: "1:1 by
                 mel byt jako skupinovy" — mirror how adding a GROUP member already works, see
                 GroupChatViewModel.LoadAddableMembersAsync's own remarks: "there's no manual paste/QR
                 fallback... this IS the only path"). The manual contact-card/invite-blob paste+QR cards
                 that used to sit below this as a fallback for someone not yet in the directory are
                 removed from the UI; NewChatViewModel's underlying commands (CreateSessionCommand,
                 AcceptInviteCommand, the QR scan toggles) are left in place, unused, rather than torn
                 out — same low-risk "UI-only" scope as this session's other navigation cleanups. -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Chat s někým z komunity" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Klepnutím na jméno appka sama založí zabezpečený chat — žádné kartičky ani kódy." FontSize="9.5" TextColor="Gray" />
                    <controls:DelayedActivityIndicator IsBusy="{Binding IsLoadingMembers}" HorizontalOptions="Center" />
                    <Label Text="Zatím tu nikdo není — buď jsi jediný aktivovaný, nebo se ostatní ještě nepřipojili." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoMembers}" />
                    <CollectionView ItemsSource="{Binding Members}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DirectoryMemberItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="11.5" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
