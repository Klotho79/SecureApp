<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.NewChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:NewChatViewModel"
    Title="New Chat">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="{Binding StatusErrorMessage}" IsVisible="{Binding HasStatusError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Start a new chat" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Paste the contact card someone shared with you from their Settings page." FontSize="12" TextColor="Gray" />
                    <Editor Text="{Binding PeerContactCardText}" HeightRequest="80" Placeholder="Paste contact card here" />
                    <Button Text="Create Chat" Command="{Binding CreateSessionCommand}" />

                    <VerticalStackLayout IsVisible="{Binding HasGeneratedInvite}" Spacing="8" Margin="0,8,0,0">
                        <Label Text="Send this back to them to finish connecting:" FontSize="12" TextColor="Gray" />
                        <Editor Text="{Binding GeneratedInviteText}" IsReadOnly="True" HeightRequest="80" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopyInviteCommand}" />
                            <Button Grid.Column="1" Text="Open Chat" Command="{Binding OpenCreatedChatCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Accept an invite" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Paste the invite someone sent you back after you shared your contact card." FontSize="12" TextColor="Gray" />
                    <Editor Text="{Binding InviteBlobText}" HeightRequest="80" Placeholder="Paste invite here" />
                    <Button Text="Accept Invite" Command="{Binding AcceptInviteCommand}" />
                    <Button Text="Open Chat" Command="{Binding OpenAcceptedChatCommand}" IsVisible="{Binding HasAcceptedSession}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
