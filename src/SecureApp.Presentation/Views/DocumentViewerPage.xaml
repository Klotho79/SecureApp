<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.DocumentViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:DocumentViewerViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto,Auto" Padding="20" RowSpacing="10">

        <Grid Grid.Row="0">
            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

            <!-- 2026-09-11: fit the whole image within the available area. It used to live in a
                 vertical ScrollView, which measures its content with unbounded height, so AspectFit
                 had no height to fit against and the image rendered larger than the window and got
                 cut off (the user's report on PC). Placed directly in the cell with Fill on both
                 axes, AspectFit now scales the whole image down to fit — nothing cropped.
                 2026-09-30 (Scale/AnchorX/AnchorY): zoom (see ZoomIn/ZoomOutCommand) scales this same
                 image AROUND ITS CENTER rather than via a ScrollView — deliberately kept out of a
                 ScrollView, which is exactly the unbounded-height trap the comment above already
                 documents fighting. This means zoomed-in content that extends past the edges isn't
                 pannable yet (a real limitation, not hidden) — good enough to read small text near
                 the middle of a page; ask again if scrolling a zoomed page turns out to matter. -->
            <Image
                Source="{Binding CurrentPageImage}"
                Aspect="AspectFit"
                IsVisible="{Binding HasImage}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Scale="{Binding ImageScale}"
                AnchorX="0.5"
                AnchorY="0.5" />
        </Grid>

        <!-- Zvětšení (2026-09-30, user's own ask — replaced the removed visible watermark, which made
             the document unreadable with no way around it: "nejde ani číst ani zvětšit"). -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Text="🔍− Zmenšit" Style="{StaticResource SecondaryButton}" Command="{Binding ZoomOutCommand}" IsEnabled="{Binding CanZoomOut}" />
            <Label Grid.Column="1" Text="{Binding ImageScale, StringFormat='{0:P0}'}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="10" TextColor="Gray" />
            <Button Grid.Column="2" Text="🔍+ Zvětšit" Style="{StaticResource SecondaryButton}" Command="{Binding ZoomInCommand}" IsEnabled="{Binding CanZoomIn}" />
        </Grid>

        <!-- Stáhnout (2026-09-30, user's own ask): saves the original decrypted file outside the app
             via the OS share sheet, and logs the download (who/what/when, admin-searchable) — see
             DocumentViewerViewModel.DownloadAsync's own remarks. -->
        <Label
            Grid.Row="2"
            Text="{Binding DownloadErrorMessage}"
            IsVisible="{Binding HasDownloadError}"
            HorizontalOptions="Center"
            TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
            VerticalOptions="Start"
            TranslationY="-28" />

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Text="⬅ Předchozí" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}" />
            <Label
                Grid.Column="1"
                Text="{Binding PageIndicatorText}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <Button Grid.Column="2" Text="⬇ Stáhnout" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanDownload}" />
            <Button Grid.Column="3" Text="Další ➡" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}" />
        </Grid>
    </Grid>
</ContentPage>
