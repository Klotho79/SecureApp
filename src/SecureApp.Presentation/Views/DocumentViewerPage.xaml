<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.DocumentViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="vm:DocumentViewerViewModel"
    Title="{Binding Title}">

    <!-- Přejmenovat (2026-09-30, user's own ask) — a toolbar item rather than another row of
         buttons; this page's bottom row is already Předchozí/indikátor/Stáhnout/Další. -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="✏ Přejmenovat" Clicked="OnRenameClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="10">

        <Grid Grid.Row="0">
            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

            <!-- 2026-09-11: fit the whole image within the available area. It used to live in a
                 vertical ScrollView, which measures its content with unbounded height, so AspectFit
                 had no height to fit against and the image rendered larger than the window and got
                 cut off (the user's report on PC). Placed directly in the cell with Fill on both
                 axes, AspectFit now scales the whole image down to fit — nothing cropped.
                 2026-09-30: pinch-to-zoom + one-finger pan while zoomed, replacing the earlier +/-
                 button attempt the user rejected ("plynule zvetsovani a posun... jak to byva
                 roztazenim prstu") — see DocumentViewerPage.xaml.cs's own remarks for the gesture
                 math (Microsoft's own documented pinch-then-pan pattern: PinchGestureRecognizer
                 alone only zooms, so PanGestureRecognizer is layered on for continued one-finger
                 panning after the pinch ends). Deliberately still not inside a ScrollView — same
                 unbounded-height trap as before; the code-behind clamps TranslationX/Y itself so
                 zoomed content can never pan past its own edges into empty space. -->
            <Image
                x:Name="DocumentImage"
                Source="{Binding CurrentPageImage}"
                Aspect="AspectFit"
                IsVisible="{Binding HasImage}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <Image.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
                </Image.GestureRecognizers>
            </Image>

            <!-- Video (2026-10-03) — local playback only, decrypted to a temp file first (see
                 DocumentViewerViewModel.LoadVideoAsync); nothing streams, nothing leaves the device. -->
            <toolkit:MediaElement
                Source="{Binding VideoSource}"
                IsVisible="{Binding IsVideo}"
                ShouldAutoPlay="False"
                ShouldShowPlaybackControls="True"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- Open externally (2026-10-03) — DOCX/PPTX and anything else with no in-app renderer. -->
            <VerticalStackLayout IsVisible="{Binding IsExternalOnly}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <Label
                    Text="Tento typ dokumentu nelze zobrazit přímo v appce."
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Button Text="📤 Otevřít v jiné appce" Command="{Binding OpenExternallyCommand}" IsEnabled="{Binding CanOpenExternally}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Stáhnout (2026-09-30, user's own ask): saves the original decrypted file outside the app
             via the OS share sheet, and logs the download (who/what/when, admin-searchable) — see
             DocumentViewerViewModel.DownloadAsync's own remarks. -->
        <Label
            Grid.Row="1"
            Text="{Binding DownloadErrorMessage}"
            IsVisible="{Binding HasDownloadError}"
            HorizontalOptions="Center"
            TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
            VerticalOptions="Start"
            TranslationY="-28" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Text="⬅ Předchozí" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}" IsVisible="{Binding IsPagedDocument}" />
            <Label
                Grid.Column="1"
                Text="{Binding PageIndicatorText}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="{Binding IsPagedDocument}" />
            <Button Grid.Column="2" Text="⬇ Stáhnout" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanDownload}" />
            <Button Grid.Column="3" Text="Další ➡" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}" IsVisible="{Binding IsPagedDocument}" />
        </Grid>
    </Grid>
</ContentPage>
