<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.DocumentViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:DocumentViewerViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="10">

        <Grid Grid.Row="0">
            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

            <!-- 2026-09-11: fit the whole image within the available area. It used to live in a
                 vertical ScrollView, which measures its content with unbounded height, so AspectFit
                 had no height to fit against and the image rendered larger than the window and got
                 cut off (the user's report on PC). Placed directly in the cell with Fill on both
                 axes, AspectFit now scales the whole image down to fit — nothing cropped. -->
            <Image
                Source="{Binding CurrentPageImage}"
                Aspect="AspectFit"
                IsVisible="{Binding HasImage}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- Milestone 4, Task 4.4: moving watermark overlay (username + timestamp + IP).
                 InputTransparent so it never blocks taps on the image/buttons underneath. -->
            <Label
                Text="{Binding WatermarkText}"
                TranslationX="{Binding WatermarkTranslationX}"
                TranslationY="{Binding WatermarkTranslationY}"
                IsVisible="{Binding HasImage}"
                InputTransparent="True"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontSize="13"
                TextColor="Red"
                Opacity="0.35" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Text="⬅ Předchozí" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}" />
            <Label
                Grid.Column="1"
                Text="{Binding PageIndicatorText}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Další ➡" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}" />
        </Grid>
    </Grid>
</ContentPage>
