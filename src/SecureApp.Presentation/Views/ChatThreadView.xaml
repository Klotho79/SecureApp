<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="SecureApp.Presentation.Views.ChatThreadView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:ChatViewModel"
    x:Name="ChatThreadRoot">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="0" RowSpacing="0">

        <Label
            Grid.Row="0"
            Text="{Binding StatusErrorMessage}"
            IsVisible="{Binding HasStatusError}"
            Margin="20,12,20,0"
            TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
            LineBreakMode="WordWrap" />

        <Grid Grid.Row="1">
            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />

            <!-- KeepItemsInView (2026-09-11): when older history is prepended on scroll-up, the item
                 already in view stays put instead of the list jumping to the oldest message (the bug
                 the user hit). Scrolling to the newest message on open / send / receive is done
                 explicitly from code-behind (ScrollToLatest), not by the scroll mode. -->
            <CollectionView x:Name="MessagesView" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepItemsInView" Margin="12,12,12,4">
                <CollectionView.ItemTemplate>
                    <!-- Template selector (2026-09-12): text-only messages (the common case) get a lean
                         bubble that never builds the attachment sub-tree; only messages that actually
                         carry a file get the fuller template. This directly cuts the per-cell UI-thread
                         work that was stealing frames from the open animation — see
                         ChatMessageTemplateSelector's own remarks. -->
                    <controls:ChatMessageTemplateSelector>
                        <controls:ChatMessageTemplateSelector.TextTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageItem">
                                <Grid Padding="3,0">
                                    <Border
                                        Padding="7,3"
                                        StrokeShape="RoundRectangle 18,18,5,18"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                        HorizontalOptions="Start"
                                        MaximumWidthRequest="340">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOutbound}" Value="True">
                                                <Setter Property="StrokeShape" Value="RoundRectangle 18,18,18,5" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="HorizontalOptions" Value="End" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <!-- Grid, not nested StackLayouts (2026-09-12): framestats on the S23+ showed the
                                             open's measure/layout phase spiking to 230-287 ms per frame — MAUI's nested
                                             VerticalStackLayout/HorizontalStackLayout do multiple measure passes per cell.
                                             A single Grid measures in one pass. This bubble is header row + text row. -->
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <!-- Delete: a plain tappable Label, not a Button — an Android Button
                                                     forces a ~48dp minimum height that inflated the whole bubble. -->
                                                <Label
                                                    Grid.Column="0"
                                                    Text="🗑"
                                                    FontSize="11"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding CanDelete}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ChatThreadRoot}, Path=BindingContext.DeleteMessageCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                                    <Label
                                                        Text="{Binding TimeLabel}"
                                                        FontSize="9"
                                                        VerticalOptions="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOutbound}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#CFE7F0, Dark={StaticResource PrimaryDarkText}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <!-- Delivery indicator (2026-09-14): ✓ sent, ✓✓ delivered — only on own messages. -->
                                                    <Label
                                                        Text="{Binding StatusGlyph}"
                                                        IsVisible="{Binding ShowStatusGlyph}"
                                                        FontSize="9"
                                                        VerticalOptions="Center"
                                                        TextColor="{AppThemeBinding Light=#CFE7F0, Dark={StaticResource PrimaryDarkText}}" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <Label Grid.Row="1" Text="{Binding Text}" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" FontSize="13" LineBreakMode="WordWrap">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOutbound}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </controls:ChatMessageTemplateSelector.TextTemplate>

                        <controls:ChatMessageTemplateSelector.AttachmentTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageItem">
                                <Grid Padding="3,0">
                                    <Border
                                        Padding="7,3"
                                        StrokeShape="RoundRectangle 18,18,5,18"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                        HorizontalOptions="Start"
                                        MaximumWidthRequest="340">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOutbound}" Value="True">
                                                <Setter Property="StrokeShape" Value="RoundRectangle 18,18,18,5" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="HorizontalOptions" Value="End" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <!-- Grid instead of nested StackLayouts — see the text template's own remark. -->
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0">
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label
                                                    Grid.Column="0"
                                                    Text="🗑"
                                                    FontSize="11"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding CanDelete}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ChatThreadRoot}, Path=BindingContext.DeleteMessageCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                                    <Label
                                                        Text="{Binding TimeLabel}"
                                                        FontSize="9"
                                                        VerticalOptions="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOutbound}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#CFE7F0, Dark={StaticResource PrimaryDarkText}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label
                                                        Text="{Binding StatusGlyph}"
                                                        IsVisible="{Binding ShowStatusGlyph}"
                                                        FontSize="9"
                                                        VerticalOptions="Center"
                                                        TextColor="{AppThemeBinding Light=#CFE7F0, Dark={StaticResource PrimaryDarkText}}" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <Label Grid.Row="1" Text="{Binding Text}" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" FontSize="13" LineBreakMode="WordWrap" IsVisible="{Binding HasText}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOutbound}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <Border Grid.Row="2" Padding="8,6" StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference ChatThreadRoot}, Path=BindingContext.OpenAttachmentCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" RowDefinitions="Auto,Auto">
                                                    <Label Grid.Column="0" Grid.RowSpan="2" Text="📄" FontSize="18" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Grid.Row="0" Text="{Binding AttachmentFileName}" FontSize="12.5" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Grid.Row="1" Text="Ze sdílené knihovny" FontSize="10.5" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </controls:ChatMessageTemplateSelector.AttachmentTemplate>
                    </controls:ChatMessageTemplateSelector>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Grid.Row="2" Margin="12,0" Padding="8,6" IsVisible="{Binding HasPendingAttachment}" StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="📎" VerticalOptions="Center" Margin="0,0,8,0" />
                <Label Grid.Column="1" Text="{Binding PendingAttachmentFileName}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Button Grid.Column="2" Text="✕" Style="{StaticResource SecondaryButton}" WidthRequest="40" Padding="0" Command="{Binding ClearPendingAttachmentCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Padding="12,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding CanCompose}" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
            <BoxView Grid.ColumnSpan="3" HeightRequest="1" VerticalOptions="Start" Margin="-12,-10,-12,0" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
            <Button Grid.Column="0" Text="📎" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Clicked="OnAttachClicked" />
            <Entry Grid.Column="1" Text="{Binding ComposeText}" Placeholder="Napište zprávu…" ReturnCommand="{Binding SendCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
            <Button Grid.Column="2" Text="Odeslat" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" />
        </Grid>

        <!-- Archived chat (2.3): read-only footer. -->
        <Label Grid.Row="3" IsVisible="{Binding IsArchived}" Padding="12,12" HorizontalOptions="Center"
               Text="📦 Archivováno — jen ke čtení" FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </Grid>
</ContentView>
