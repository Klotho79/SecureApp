<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.RedakceSectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:RedakceViewModel"
    Title="{Binding SectionTitle}">

    <!-- One Redakce action in its own window (2026-10-26) — the cards that used to sit inline on RedakcePage,
         unchanged apart from the header (the window title says it). The ViewModel's Section picks the card. -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Zpráva na nástěnku (Admin/Modifier) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBoardSection}">
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanPostToBoard}">
                    <Label Text="Zpráva se objeví všem členům na jejich Nástěnce. Vyžaduje nastavený klíč sdílené knihovny." FontSize="9.5" TextColor="Gray" />
                    <Editor Text="{Binding BoardMessageText}" Placeholder="Co chcete oznámit…" AutoSize="TextChanges" HeightRequest="80" />
                    <Button Text="Odeslat na nástěnku" Command="{Binding PostToBoardCommand}" />
                    <Label Text="{Binding BoardStatusText}" IsVisible="{Binding HasBoardStatus}" FontSize="9.5" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Možné stavy sálů (Admin/Modifier) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRoomStatusSection}">
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanManageRoomStatusOptions}">
                    <Label Text="Seznam stavů, které si může vybrat kdokoliv na řádku svého sálu na Stavu sálů." FontSize="9.5" TextColor="Gray" />
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding RoomStatusOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding .}" FontSize="10.5" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="✕" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RedakceViewModel}}, Path=RemoveStatusOptionCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="Nový stav…" Text="{Binding NewStatusOptionText}" FontSize="10.5" />
                        <Button Grid.Column="1" Text="Přidat" Style="{StaticResource SecondaryButton}" Command="{Binding AddStatusOptionCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Možné poznámky k sálům (Admin/Modifier) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRoomNotesSection}">
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanManageRoomStatusOptions}">
                    <Label Text="Např. „poslední uzavření sálu“, „poslední výkon“, „sál pokračuje do služby“ — volitelný druhý výběr na řádku sálu na Stavu sálů." FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding RoomStatusNoteOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding .}" FontSize="10.5" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="✕" Style="{StaticResource SecondaryButton}" WidthRequest="36" Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RedakceViewModel}}, Path=RemoveNoteOptionCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="Nová poznámka…" Text="{Binding NewNoteOptionText}" FontSize="10.5" />
                        <Button Grid.Column="1" Text="Přidat" Style="{StaticResource SecondaryButton}" Command="{Binding AddNoteOptionCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Moje zadání (kdokoli s přiděleným dokumentem, jen PC) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsMyAssignmentsSection}">
                <Label Text="Dokumenty, které vám byly přiděleny k vypracování. Právo upravovat trvá do schválení dokumentu." FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding MyAssignments}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CmsAssignmentItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Label Text="{Binding Title}" FontSize="10.5" FontAttributes="Bold" />
                                    <Label Text="{Binding StatusText}" FontSize="9.5" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="✏ Vypracovat" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RedakceViewModel}}, Path=OpenMyAssignmentCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Zadání dokumentů (Admin/Modifier, jen PC) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsCmsAssignSection}">
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanAssignCms}">
                    <Label Text="Zadejte název dokumentu a vyberte člena, který ho vypracuje. Editor smí upravovat jen tento dokument, a to do jeho schválení." FontSize="9.5" TextColor="Gray" LineBreakMode="WordWrap" />
                    <Entry Placeholder="Název dokumentu…" Text="{Binding NewAssignmentTitle}" FontSize="10.5" />
                    <Picker Title="Editor…" ItemsSource="{Binding AssignableMembers}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedAssignee}" FontSize="10.5" />
                    <Button Text="Přidělit" Command="{Binding AssignCmsEditorCommand}" HorizontalOptions="Start" />
                    <Label Text="{Binding AssignmentStatusText}" IsVisible="{Binding HasAssignmentStatus}" FontSize="9.5" LineBreakMode="WordWrap" />
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding AllAssignments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CmsAssignmentItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Title}" FontSize="10.5" FontAttributes="Bold" />
                                        <Label FontSize="9.5" TextColor="Gray" Text="{Binding EditorName, StringFormat='Editor: {0}'}" />
                                        <Label Text="{Binding StatusText}" FontSize="9.5" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Odebrat" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RedakceViewModel}}, Path=RevokeCmsEditorCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Kategorie knihovny (Modifier/Admin) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsLibraryCategoriesSection}">
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanManageLibrary}">
                    <Label Text="Podkategorie se otevírají a procházejí v Knihovně — přidávání a mazání je tady." FontSize="9.5" TextColor="Gray" />

                    <Picker ItemsSource="{Binding LibraryTopCategories}" SelectedItem="{Binding SelectedLibraryTopCategory}" Title="Kategorie" />

                    <controls:DelayedActivityIndicator IsBusy="{Binding IsLoadingLibrarySubcategories}" HorizontalOptions="Center" />
                    <Label Text="Tato kategorie zatím nemá žádné podkategorie." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoLibrarySubcategories}" />

                    <CollectionView ItemsSource="{Binding LibrarySubcategories}" IsVisible="{Binding HasLibrarySubcategories}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubcategoryItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="10.5" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="🗑" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" Padding="4,0"
                                                IsVisible="{Binding CanDelete}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RedakceViewModel}}, Path=DeleteLibrarySubcategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding NewLibrarySubcategoryNameText}" Placeholder="Název nové podkategorie" />
                        <Button Grid.Column="1" Text="＋ Přidat" Style="{StaticResource SecondaryButton}" Command="{Binding AddLibrarySubcategoryCommand}" />
                    </Grid>

                    <Label Text="{Binding LibraryCategoriesStatusText}" FontSize="9.5" IsVisible="{Binding HasLibraryCategoriesStatus}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
