<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.RoomStatusPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:RoomStatusViewModel"
    Title="Stav sálů">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" />
            <Label Text="Žádná pracoviště v katalogu." FontSize="9.5" TextColor="Gray" IsVisible="{Binding HasNoRoomStatus}" />

            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding RoomStatusRows}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoomStatusRowItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8">
                            <Border.Triggers>
                                <!-- Green (2026-10-14, user's own ask) — a device can have more than one "moje" sál today (see RoomStatusViewModel's own remarks), each one highlighted the same way. -->
                                <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="6">
                                <!-- Same shape as a Rozpis card (2026-10-22, user's own ask): sál name with its
                                     note underneath on the left, who is in the sál and the status beside it
                                     on the right. Shown to EVERYONE and reflects only what is saved (the
                                     pickers below are edit-gated). -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding WorkplaceName}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="moje" FontSize="9" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" IsVisible="{Binding IsMine}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding SavedNote}" FontSize="9.5" LineBreakMode="WordWrap" IsVisible="{Binding HasSavedNote}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                        <Label Text="{Binding PeopleText}" FontSize="9.5" HorizontalTextAlignment="End" IsVisible="{Binding HasPeople}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                        <Border Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 999" HorizontalOptions="End"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                                                IsVisible="{Binding HasSavedStatus}">
                                            <Label Text="{Binding SavedStatus}" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding SavedCategory}" Value="Success">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding SavedCategory}" Value="Info">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding SavedCategory}" Value="Warn">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource WarnSoftDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding SavedCategory}" Value="Danger">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Label Text="— bez stavu —" FontSize="9.5" TextColor="Gray" HorizontalOptions="End" IsVisible="{Binding HasNoSavedStatus}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Editable (own sál, or Admin/Modifier on any sál): Status + Poznámka pickers + Uložit. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                                    <Picker Grid.Column="0" Title="Vyberte stav" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" FontSize="10.5" />
                                    <Button Grid.Column="1" Text="✔" Style="{StaticResource SecondaryButton}" WidthRequest="40" Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoomStatusViewModel}}, Path=SetRoomStatusCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                                <Picker Title="Poznámka (volitelné)" ItemsSource="{Binding NoteOptions}" SelectedItem="{Binding SelectedNote}" FontSize="10.5" IsVisible="{Binding CanEdit}" />

                                <Label Text="{Binding UpdatedInfoText}" FontSize="8.5" TextColor="Gray" IsVisible="{Binding HasStatus}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
