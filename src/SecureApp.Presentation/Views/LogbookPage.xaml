<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.LogbookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:LogbookViewModel"
    Title="Logbook"
    Shell.NavBarIsVisible="False">
    <!-- Shell's own top app bar (white "Logbook" text on the theme bar) duplicated the styled blue
         PageTitle Label right below it (2026-09-10, user's own ask: keep the blue one, drop the
         white one) — hidden here rather than just blanking Title, so no empty bar strip is left
         behind either. Title itself stays set (used for things like the browser-tab/task-switcher
         label on some platforms), just not shown as a visible bar on this page. -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Logbook" Style="{StaticResource PageTitle}" />
                <!-- Správa katalogu (2026-09-10) — vlastní stránka, viditelná jen když je vůbec co
                     spravovat (aspoň jedno z obojího dovoleno); samotné zaznamenání výkonu/odškrtání
                     check-listu zůstává tady, jen jejich SPRÁVA (nové typy/check-listy) se přesunula
                     pryč, aby denní použití nesdílelo obrazovku s administrativou. -->
                <Button Grid.Column="1" Text="⚙ Správa" Style="{StaticResource SecondaryButton}" Command="{Binding OpenManageCommand}" IsVisible="{Binding CanManageAnything}" VerticalOptions="Center" />
            </Grid>

            <Label Text="{Binding StatusErrorMessage}" IsVisible="{Binding HasStatusError}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" />

            <!-- Check-listy -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Check-listy" Style="{StaticResource SectionHeader}" Margin="0" />

                    <Label Text="Zatím tu žádný check-list není." FontSize="12" TextColor="Gray" IsVisible="{Binding HasNoChecklists}" />

                    <CollectionView x:Name="ChecklistsView" ItemsSource="{Binding Checklists}" SelectionMode="Single" SelectionChanged="OnChecklistSelected">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogbookChecklistListItem">
                                <Grid Padding="0,6">
                                    <Label Text="{Binding Name, StringFormat='{0} ›'}" FontSize="15" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Zaznamenat výkon — vidí a smí každá role, Viewer nevyjímaje (2026-09-10, viz RoleAccessPolicy's own remarks); IsVisible zůstává i tak, pro symetrii se stejným vzorem u ostatních karet. -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CanRecordProcedure}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Zaznamenat výkon" Style="{StaticResource SectionHeader}" Margin="0" />

                    <Picker ItemsSource="{Binding ProcedureTypeOptions}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProcedureType}" Title="Typ výkonu" />
                    <Picker ItemsSource="{Binding LevelOptions}" SelectedIndex="{Binding SelectedLevelIndex}" Title="Úroveň" />
                    <Entry Text="{Binding NoteText}" Placeholder="Poznámka (nepovinné)" />
                    <Entry Text="{Binding PlaceText}" Placeholder="Místo (nepovinné)" />
                    <Button Text="Zaznamenat" Command="{Binding RecordProcedureCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Statistika — vidí každá role včetně Viewer (2026-09-10, viz RoleAccessPolicy's own
                 remarks). Reformátováno (2026-09-10, "zkratka výkonu, počet a po rozkliknutí
                 ostatní údaje"): každý řádek je sbalený (zkratka + počet), ťuknutím se rozbalí
                 seznam jednotlivých záznamů (datum, úroveň, poznámka, místo). -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CanViewStatistics}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Statistika" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Zatím žádné zaznamenané výkony." FontSize="12" TextColor="Gray" IsVisible="{Binding HasNoStatistics}" />

                    <CollectionView ItemsSource="{Binding Statistics}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogbookStatGroupItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                            </Grid.GestureRecognizers>
                                            <Border Grid.Column="0" Padding="6,2" StrokeShape="RoundRectangle 6" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Center">
                                                <Label Text="{Binding Abbreviation}" FontSize="12.5" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="13.5" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding CategoryLabel}" FontSize="10.5" TextColor="Gray" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" Text="{Binding Count}" />
                                        </Grid>

                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding Entries}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LogbookStatEntryItem">
                                                    <Border Padding="8,6" StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <Label Grid.Column="0" Text="{Binding DateText}" FontSize="11.5" FontAttributes="Bold" />
                                                                <Label Grid.Column="1" Text="{Binding LevelLabel}" FontSize="11" TextColor="Gray" />
                                                            </Grid>
                                                            <Label Text="{Binding Place}" FontSize="11" IsVisible="{Binding HasPlace}" />
                                                            <Label Text="{Binding Note}" FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" IsVisible="{Binding HasNote}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
