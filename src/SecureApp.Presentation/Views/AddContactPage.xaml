<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.AddContactPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    x:DataType="vm:AddContactViewModel"
    Title="Přidat kontakt">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Přidává se do sdíleného firemního seznamu — uvidí ho celá komunita." FontSize="9.5" TextColor="Gray" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" LineBreakMode="WordWrap" />

            <Label Text="Jméno" FontAttributes="Bold" />
            <Entry Text="{Binding DisplayName}" Placeholder="Jméno / oddělení" />

            <Label Text="Klapka / telefon" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry Text="{Binding Phone}" Placeholder="Nepovinné" Keyboard="Telephone" />

            <Label Text="Poznámka" FontAttributes="Bold" Margin="0,8,0,0" />
            <Editor Text="{Binding Note}" Placeholder="Nepovinné" HeightRequest="70" />

            <Button Text="Uložit" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
