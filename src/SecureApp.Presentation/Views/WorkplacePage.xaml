<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.WorkplacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:WorkplaceViewModel"
    Title="Rozpis">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" />
            <Label Text="{Binding SyncStatusText}" IsVisible="{Binding HasSyncStatus}" FontSize="11.5" TextColor="Gray" HorizontalOptions="Center" />

            <!-- Dnes (spec §6 TODAY block) — always today's own status, independent of which week the
                 strip below is currently showing. -->
            <Border Style="{StaticResource CardBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Today.OpenCommand}" CommandParameter="{Binding Today}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="Work">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="OnCall">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource WarnSoftDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="BusinessTrip">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="Training">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="Vacation">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="SickLeave">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="DayOff">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Today.TypeText}" Value="Other">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Dnes" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Dnes není naplánovaná žádná směna. Klepnutím přidáte." FontSize="13" TextColor="Gray" IsVisible="{Binding Today.HasNoAssignment}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding Today.HasAssignment}">
                        <Label Grid.Column="0" Text="{Binding Today.Glyph}" FontSize="28" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="{Binding Today.TypeLabel}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Today.WorkplaceText}" FontSize="13.5" IsVisible="{Binding Today.HasWorkplace}" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Today.TimeText}" FontSize="13" TextColor="Gray" VerticalOptions="Center" IsVisible="{Binding Today.HasTime}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Týden/Měsíc přepínač (spec §7 — "Day / Week / Month views") — same selected-chip visual
                 convention as Nástěnka's own filter chips (Border+Chip style, DataTrigger-driven
                 AccentStrong fill + white text when selected), reused here rather than inventing a
                 new toggle control. -->
            <HorizontalStackLayout Spacing="8">
                <Border Style="{StaticResource Chip}" Margin="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowWeekViewCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsMonthView}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Týden" Style="{StaticResource ChipLabel}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsMonthView}" Value="False">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowMonthViewCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsMonthView}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Měsíc" Style="{StaticResource ChipLabel}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsMonthView}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </HorizontalStackLayout>

            <!-- Tento týden (spec §7 — "Week is primary"). -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsWeekView}">
                <Button Grid.Column="0" Text="‹" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding PreviousWeekCommand}" />
                <Label Grid.Column="1" Text="{Binding WeekLabel}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="›" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding NextWeekCommand}" />
            </Grid>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsWeekView}" BindableLayout.ItemsSource="{Binding WeekDays}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssignmentDayItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Work">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="OnCall">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource WarnSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="BusinessTrip">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Training">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Vacation">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="SickLeave">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="DayOff">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Other">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="60,6,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding DayLabel}" FontSize="12.5" FontAttributes="Bold" VerticalOptions="Center" />
                                <BoxView Grid.Column="1" CornerRadius="3" IsVisible="{Binding HasAssignment}">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="Work">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource InfoDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="OnCall">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="BusinessTrip">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="Training">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="Vacation">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="DayOff">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="SickLeave">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding TypeText}" Value="Other">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout Grid.Column="2" Spacing="1">
                                    <Label Text="{Binding DisplayTypeLabel}" FontSize="13.5" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding WorkplaceText}" FontSize="12" IsVisible="{Binding HasWorkplace}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="3" Text="{Binding TimeText}" FontSize="11.5" TextColor="Gray" VerticalOptions="Center" IsVisible="{Binding HasTime}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Měsíc (spec §7). Fixed 6-row/42-cell CollectionView with an explicit HeightRequest —
                 sized so its own content never exceeds it, which is what keeps it well-behaved inside
                 the page's outer ScrollView (no internal scroll of its own to conflict with the
                 page's). GridItemsLayout Span="7" is what guarantees exactly 7 columns regardless of
                 window width — this app also runs on a wide PC window, where a Wrap-based layout
                 (the pattern LibraryPage's tag chips use) couldn't guarantee the day-of-week grid
                 stays 7-wide. -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsMonthView}">
                <Button Grid.Column="0" Text="‹" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding PreviousMonthCommand}" />
                <Label Grid.Column="1" Text="{Binding MonthLabel}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="›" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding NextMonthCommand}" />
            </Grid>

            <CollectionView ItemsSource="{Binding MonthDays}" SelectionMode="None" IsVisible="{Binding IsMonthView}" HeightRequest="300">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonthDayCell">
                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" StrokeThickness="1.5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <!-- Full-cell color fill (2026-09-21, "udelej vyraznejsi oznaceni" — the previous
                                     5x5 dot under the day number was easy to miss entirely; filling the whole
                                     cell with the type's Soft color makes it unmissable at a glance, same tokens
                                     the Week strip/Dnes card now also use for the same reason). IsToday's own
                                     Stroke trigger still layers on top since it's a different property. -->
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Work">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="OnCall">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource WarnSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="BusinessTrip">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Training">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Vacation">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="SickLeave">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="DayOff">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TypeText}" Value="Other">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid Padding="2">
                                <Label Text="{Binding DayNumberText}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
