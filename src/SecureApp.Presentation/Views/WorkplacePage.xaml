<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SecureApp.Presentation.Views.WorkplacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecureApp.Presentation.ViewModels"
    xmlns:controls="clr-namespace:SecureApp.Presentation.Controls"
    x:DataType="vm:WorkplaceViewModel"
    Title="Rozpis">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <controls:DelayedActivityIndicator IsBusy="{Binding IsLoading}" HorizontalOptions="Center" />
            <Label Text="{Binding SyncStatusText}" IsVisible="{Binding HasSyncStatus}" FontSize="9" TextColor="Gray" HorizontalOptions="Center" />

            <!-- Dnes (spec §6 TODAY block) — always today's own status, independent of which week the
                 strip below is currently showing. -->
            <Border Style="{StaticResource CardBorder}" BackgroundColor="{Binding Today.SoftColor}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Today.OpenCommand}" CommandParameter="{Binding Today}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Dnes" Style="{StaticResource SectionHeader}" Margin="0" />
                    <Label Text="Dnes není naplánovaná žádná směna. Klepnutím přidáte." FontSize="10.5" TextColor="Gray" IsVisible="{Binding Today.HasNoAssignment}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding Today.HasAssignment}">
                        <Label Grid.Column="0" Text="{Binding Today.Glyph}" FontSize="22.5" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="{Binding Today.TypeLabel}" FontSize="13.5" FontAttributes="Bold" />
                            <Label Text="{Binding Today.WorkplaceText}" FontSize="11" IsVisible="{Binding Today.HasWorkplace}" TextColor="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Today.TimeText}" FontSize="10.5" TextColor="Gray" VerticalOptions="Center" IsVisible="{Binding Today.HasTime}" />
                    </Grid>
                    <!-- On-call overlay (2026-09-21) — a duty on top of today's own primary type, e.g.
                         a normal shift followed later the same day by on-call; see
                         WorkAssignment.OnCallWorkplaceName's own remarks. -->
                    <Label Text="{Binding Today.OnCallText}" FontSize="10.5" FontAttributes="Bold" IsVisible="{Binding Today.HasOnCall}" TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Týden/Měsíc přepínač (spec §7 — "Day / Week / Month views") — same selected-chip visual
                 convention as Nástěnka's own filter chips (Border+Chip style, DataTrigger-driven
                 AccentStrong fill + white text when selected), reused here rather than inventing a
                 new toggle control. ℹ legend toggle (2026-09-21, "k tomu bude třeba legenda...
                 sbalitelná/rozklikávací") shares this row rather than taking its own — collapsed by
                 default so it doesn't compete for space with the more-used Týden/Měsíc toggle. -->
            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                    <Border Style="{StaticResource Chip}" Margin="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowWeekViewCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsMonthView}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Týden" Style="{StaticResource ChipLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsMonthView}" Value="False">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowMonthViewCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsMonthView}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Měsíc" Style="{StaticResource ChipLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsMonthView}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="ℹ" Style="{StaticResource SecondaryButton}" WidthRequest="40" Padding="0" Command="{Binding ToggleLegendCommand}" />
            </Grid>

            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsLegendExpanded}">
                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" BindableLayout.ItemsSource="{Binding LegendItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssignmentLegendItem">
                            <HorizontalStackLayout Spacing="5" Margin="0,3,14,3">
                                <BoxView CornerRadius="3" WidthRequest="12" HeightRequest="12" Color="{Binding Color}" VerticalOptions="Center" />
                                <Label Text="{Binding Label}" FontSize="9.5" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>

            <!-- Tento týden (spec §7 — "Week is primary"). -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsWeekView}">
                <Button Grid.Column="0" Text="‹" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding PreviousWeekCommand}" />
                <Label Grid.Column="1" Text="{Binding WeekLabel}" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="›" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding NextWeekCommand}" />
            </Grid>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsWeekView}" BindableLayout.ItemsSource="{Binding WeekDays}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssignmentDayItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10,8" BackgroundColor="{Binding SoftColor}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="60,6,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding DayLabel}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                                <BoxView Grid.Column="1" CornerRadius="3" Color="{Binding AccentColor}" IsVisible="{Binding HasAssignment}" />
                                <VerticalStackLayout Grid.Column="2" Spacing="1">
                                    <Label Text="{Binding DisplayTypeLabel}" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding WorkplaceText}" FontSize="9.5" IsVisible="{Binding HasWorkplace}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding OnCallText}" FontSize="9.5" FontAttributes="Bold" IsVisible="{Binding HasOnCall}" TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="3" Text="{Binding TimeText}" FontSize="9" TextColor="Gray" VerticalOptions="Center" IsVisible="{Binding HasTime}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Měsíc (spec §7). Fixed 6-row/42-cell CollectionView with an explicit HeightRequest —
                 sized so its own content never exceeds it, which is what keeps it well-behaved inside
                 the page's outer ScrollView (no internal scroll of its own to conflict with the
                 page's). GridItemsLayout Span="7" is what guarantees exactly 7 columns regardless of
                 window width — this app also runs on a wide PC window, where a Wrap-based layout
                 (the pattern LibraryPage's tag chips use) couldn't guarantee the day-of-week grid
                 stays 7-wide. -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsMonthView}">
                <Button Grid.Column="0" Text="‹" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding PreviousMonthCommand}" />
                <Label Grid.Column="1" Text="{Binding MonthLabel}" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="›" Style="{StaticResource SecondaryButton}" WidthRequest="44" Padding="0" Command="{Binding NextMonthCommand}" />
            </Grid>

            <CollectionView ItemsSource="{Binding MonthDays}" SelectionMode="None" IsVisible="{Binding IsMonthView}" HeightRequest="300">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonthDayCell">
                        <Border Style="{StaticResource CardBorder}" Margin="0" Padding="0" BackgroundColor="{Binding SoftColor}" StrokeThickness="1.5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <!-- Full-cell color fill (2026-09-21, "udelej vyraznejsi oznaceni" — the previous
                                 5x5 dot under the day number was easy to miss entirely; filling the whole
                                 cell with the type's Soft color makes it unmissable at a glance, same tokens
                                 the Week strip/Dnes card now also use for the same reason). SoftColor comes
                                 straight off the bound MonthDayCell (see its own remarks) rather than a
                                 per-type DataTrigger, so a user-customized color (Settings → Barvy typů)
                                 shows up here too. IsToday/IsCurrentMonth still need triggers since those
                                 aren't color. -->
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentStrong}, Dark={StaticResource AccentStrongDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid Padding="2">
                                <Label Text="{Binding DayNumberText}" FontSize="10.5" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                <!-- On-call overlay marker (2026-09-21) — the grid cell is too small for
                                     the workplace name itself (see the Week strip/Dnes card for that),
                                     just a small corner dot flagging "there's also a duty on top of this
                                     day's own type"; see WorkAssignment.OnCallWorkplaceName's own remarks. -->
                                <BoxView CornerRadius="3" WidthRequest="6" HeightRequest="6" IsVisible="{Binding HasOnCall}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0" Color="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
