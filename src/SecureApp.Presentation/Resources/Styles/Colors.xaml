<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- 2026-09-06 visual redesign — replaces the untouched default MAUI template palette
         (purple Primary/Magenta tab bar) with a calm, clinical blue-teal, informed by the
         "SecureApp Redesign" mockup (https://claude.ai/code/artifact/7a7bebe1-6ea6-4df1-9908-b9bbdc900ccf).
         Kept under the SAME keys the whole app's Styles.xaml already binds to, so every page
         picks up the new look without a page-by-page rewrite here — only genuinely new tokens
         (AccentSoft/AccentStrong/SurfaceAlt/Warn/SuccessSoft) are additions. -->
    <Color x:Key="Primary">#14688A</Color>
    <Color x:Key="PrimaryDark">#6FC3E5</Color>
    <Color x:Key="PrimaryDarkText">#0D2A33</Color>
    <Color x:Key="Secondary">#D7EAF1</Color>
    <Color x:Key="SecondaryDarkText">#6FC3E5</Color>
    <Color x:Key="Tertiary">#0D4658</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#14688A</Color>
    <Color x:Key="MidnightBlue">#16232B</Color>
    <Color x:Key="OffBlack">#1B1F22</Color>

    <Color x:Key="Gray100">#E4E8EB</Color>
    <Color x:Key="Gray200">#CBD3D8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#26292C</Color>

    <!-- Semantic tokens (status text/icons) — used via AppThemeBinding so success/error text
         stays legible and consistent in both themes instead of ad-hoc inline colors per page. -->
    <Color x:Key="Success">#1F7A5C</Color>
    <Color x:Key="SuccessDark">#66BB6A</Color>
    <Color x:Key="SuccessSoft">#E3F5EC</Color>
    <Color x:Key="SuccessSoftDark">#173428</Color>
    <Color x:Key="Danger">#C62828</Color>
    <Color x:Key="DangerDark">#EF5350</Color>
    <Color x:Key="DangerSoft">#FBE4E4</Color>
    <Color x:Key="DangerSoftDark">#3A1414</Color>
    <Color x:Key="Warn">#B5730C</Color>
    <Color x:Key="WarnDark">#E5A845</Color>
    <Color x:Key="WarnSoft">#FBEFDD</Color>
    <Color x:Key="WarnSoftDark">#3A2C10</Color>

    <!-- Info (2026-09-20, Notification Hub — NOTIFICATION_HUB_SPEC.md) — a true blue, distinct from
         the teal-leaning AccentStrong, for NotificationPriority.Normal / the "Zprávy" (messages)
         category, matching the reference design images' color language. -->
    <Color x:Key="Info">#1565C0</Color>
    <Color x:Key="InfoDark">#64B5F6</Color>
    <Color x:Key="InfoSoft">#E1EDFA</Color>
    <Color x:Key="InfoSoftDark">#122A40</Color>

    <!-- Accent tint pair — active nav item / selected chip / role badge backgrounds, with
         AccentStrong as the readable text/icon color to pair with the tint (same role AccentSoft
         + AccentStrong play together in the redesign mockup). -->
    <Color x:Key="AccentSoft">#E3F0F5</Color>
    <Color x:Key="AccentSoftDark">#123240</Color>
    <Color x:Key="AccentStrong">#0D4E64</Color>
    <Color x:Key="AccentStrongDark">#7FCBE8</Color>

    <!-- One step off White/OffBlack — search-bar fills, tag/chip backgrounds, anything that
         should sit visually behind a CardBorder without being the same flat white/black. -->
    <Color x:Key="SurfaceAlt">#EEF2F5</Color>
    <Color x:Key="SurfaceAltDark">#232729</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
