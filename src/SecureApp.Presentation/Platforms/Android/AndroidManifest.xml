<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config">
		<!-- Self-update (2026-09-23) — lets NativeAppInstaller hand a downloaded APK (saved to the
		     app's own cache dir) to the system package installer via a content:// Uri instead of a
		     raw file:// one, which modern Android refuses (FileUriExposedException) to pass between
		     apps. Own explicit authority/paths file rather than relying on MAUI Essentials' own
		     bundled FileProvider, so exactly what's shared is unambiguous. -->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="com.companyname.secureapp.presentation.updateprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_file_paths" />
		</provider>
		<!-- Vestavěný tunel (2026-10-31, VPN_EMBED_PLAN.md) — GoBackend.VpnService je hotová třída
		     z com.wireguard.android:tunnel (binding SecureApp.WireGuard.Android), appka ji sama
		     nespouští přímo, GoBackend ji startuje interně při SetState(..., Up, ...). Musí být
		     deklarovaná v manifestu s BIND_VPN_SERVICE a intent-filter android.net.VpnService,
		     jinak ji systém nenajde. -->
		<service
			android:name="com.wireguard.android.backend.GoBackend$VpnService"
			android:exported="false"
			android:permission="android.permission.BIND_VPN_SERVICE">
			<intent-filter>
				<action android:name="android.net.VpnService" />
			</intent-filter>
		</service>
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Self-update (2026-09-23) — required on Android 8+ (API 26+) to launch the package installer
	     for a downloaded APK from within the app itself, rather than only via a browser download.
	     Android still shows its own "install unknown apps" confirmation prompt to the user regardless
	     — this permission alone does not silently install anything. -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<!-- Notification Hub (2026-09-20, see NOTIFICATION_HUB_SPEC.md) — required at runtime on
	     Android 13+ (API 33+) to post the system notifications NativeNotificationService builds;
	     requested explicitly in MainActivity.OnCreate. Older Android versions grant it automatically
	     at install time, this declaration alone is enough for those. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Background update download (2026-09-24) — the update APK downloads in a foreground Service
	     so it survives leaving Settings / switching apps / locking the screen. FOREGROUND_SERVICE is
	     required from Android 9 (API 28); the typed FOREGROUND_SERVICE_DATA_SYNC additionally from
	     Android 14 (API 34), matching the service's own foregroundServiceType="dataSync". -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<!-- 2026-10-16, found live via Petr Faltus's device crash-looping on every launch of 1.69 (relay
	     applog, device c1b2f0ab, "Unable to create service communityToolkit.maui.media.services" ←
	     SecurityException: FGS type mediaPlayback requires FOREGROUND_SERVICE_MEDIA_PLAYBACK on
	     Android 14+/targetSdk 34+) — CommunityToolkit.Maui.MediaElement's own Android service
	     (used by DocumentViewerPage for video attachments) declares foregroundServiceType="mediaPlayback"
	     in its merged manifest; this app manifest never declared the matching typed permission, so the
	     OS refused to start it and took the whole process down as an unhandled exception at launch. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<!-- Background messaging (2026-09-26) — RelayConnectionService keeps the relay connection alive
	     while the app is closed (typed remoteMessaging, Android 14+), restarts after reboot/update,
	     and the app can ask to be exempted from battery optimization so Doze doesn't cut it off. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>