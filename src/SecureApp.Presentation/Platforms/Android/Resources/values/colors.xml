<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2026-09-20: these were still the untouched default MAUI template purple, left over from
         before the 2026-09-06 teal/blue redesign (see Resources/Styles/Colors.xaml's own remarks) —
         the XAML Shell style overrides Shell's own chrome, but native Android widgets Shell renders
         directly from the platform theme (e.g. the Knihovna/Dokumenty sub-tab strip on the Soubory
         tab, a multi-ShellContent Tab) read colorPrimary/colorAccent instead, so the leftover purple
         kept showing through there specifically. Matched to Colors.xaml's Primary/AccentStrong. -->
    <color name="colorPrimary">#14688A</color>
    <color name="colorPrimaryDark">#0D4E64</color>
    <color name="colorAccent">#0D4E64</color>

    <!-- Phase 7 home-screen widget (2026-09-22, NOTIFICATION_HUB_SPEC.md §9) — matched to
         Resources/Styles/Colors.xaml's AccentStrong token so the widget reads as the same app, not a
         separately-themed native surface (RemoteViews can't reference the XAML ResourceDictionary
         directly, so this is a deliberate plain duplicate, not a shared source). -->
    <color name="widgetAccent">#0D4E64</color>
    <!-- 2026-09-22/23, user's own iteration: light gray → black at 20% opacity ("#33", too see-
         through per their own follow-up "moc velká průhlednost") → black at ~55% opacity ("#8C") for
         a card that actually reads as its own surface. Text/muted-text are light so they stay
         readable against this dark, wallpaper-blended card. -->
    <color name="widgetCardBackground">#8C000000</color>
    <color name="widgetCardText">#FFFFFF</color>
    <color name="widgetCardTextMuted">#CCCCCC</color>
    <!-- 2026-09-23, user's own ask: "barevně zvýrazni služby" (color-highlight on-call duty days) —
         a vivid amber/gold, tuned to actually pop against the dark translucent card background rather
         than the app's own (darker, light-theme-tuned) Warn token, which would nearly disappear here. -->
    <color name="widgetOnCallHighlight">#FFCA28</color>
</resources>