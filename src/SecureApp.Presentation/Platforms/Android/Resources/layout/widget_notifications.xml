<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 7 home-screen widget (2026-09-22, NOTIFICATION_HUB_SPEC.md §9) — the three counter pills the
     reference image (design/notification-hub-reference/widget-reference.jpg) originally called for are
     GONE (2026-09-23, user's own explicit ask: "pilulky vyhoď a nech jen jeden řádek") — replaced by a
     single one-line "latest notification" ticker at the very top instead. Below it: the 5-day weekly
     rozpis (2026-09-22, user's own ask). RemoteViews only supports a narrow subset of View classes (no
     CardView/ConstraintLayout) — the "card" here is a plain LinearLayout with a rounded-rect shape
     drawable background, not a real elevated Material card. -->
<!-- 2026-10-05, user's own report: the last rozpis row sometimes gets clipped on launchers that
     give this widget a tight cell height — the widget is already about as tall as it should be
     (not growing it further), so every margin/padding below was trimmed instead of removing any
     row or content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 2026-09-23 — the latest notification, one line, truncated with an ellipsis rather than a true
         animated marquee: RemoteViews TextView marquee only actually scrolls while the view has real
         focus, which a home-screen widget can't reliably hold, so a genuinely "probíhající" (running)
         ticker isn't achievable here — ellipsize="marquee" is left set anyway (harmless) in case a
         given launcher does grant it focus, but static truncation is the realistic baseline. -->
    <TextView
        android:id="@+id/widget_latest_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text=""
        android:textColor="@color/widgetCardText"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Weekly rozpis: 5 rows starting from TODAY (not Monday) so the most relevant day always leads,
         each a colored square (the day's own AssignmentType color — same per-device-customizable
         palette AssignmentColorCatalog already gives the in-app calendar) + the day/date + a one-line
         summary. Row 1 (always today) gets its own background drawable (widget_row_today_background)
         set dynamically in code for emphasis — the other 4 rows stay plain/transparent. -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:background="@drawable/widget_card_background"
        android:padding="6dp">

        <!-- Rozpis ⇄ Služby switch (2026-09-26, left) + open Kontakty (2026-09-29, user's ask, right) —
             one header row, two independent taps. The switch only swaps the card's content in place
             (a broadcast back to the provider), it never opens the app; Kontakty always opens the app,
             same "widgetRoute" mechanism the card body already uses for Rozpis (see RefreshAsync's own
             remarks) — ContactsPage IS a real tab, so no WorkplaceRoute-style tab-highlight fix-up is
             needed here, a plain absolute "//ContactsTab" already lands correctly highlighted. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_mode_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="3dp"
                android:text="Služby ›"
                android:textColor="@color/widgetOnCallHighlight"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_open_contacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:text="☎ Kontakty"
                android:textColor="@color/widgetCardText"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Today's full duty list, one row per person, "Pozice: Jméno" + a tappable phone icon
             (2026-09-29, user's ask) when that person resolves to a dialable number in the shared
             contact directory — shown instead of the day rows. RemoteViews has no dynamic-length list
             without a RemoteViewsService adapter, so this follows the exact same fixed-row-array
             pattern the 5-day rozpis rows above already use: a generous fixed count
             (NotificationsWidgetProvider.MaxDutyRows), extra rows hidden when the day has fewer
             people than that. -->
        <LinearLayout android:id="@+id/widget_duty_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:id="@+id/widget_duty1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/widget_duty1_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/widgetCardText" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                <FrameLayout android:id="@+id/widget_duty1_phone_tap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="gone">
                    <ImageView android:id="@+id/widget_duty1_phone" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/widget_ic_phone" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_duty2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/widget_duty2_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/widgetCardText" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                <FrameLayout android:id="@+id/widget_duty2_phone_tap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="gone">
                    <ImageView android:id="@+id/widget_duty2_phone" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/widget_ic_phone" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_duty3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/widget_duty3_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/widgetCardText" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
