                <TextView android:id="@+id/widget_duty10_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/widgetCardText" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
