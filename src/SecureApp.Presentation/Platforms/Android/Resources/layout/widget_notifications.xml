            <TextView android:id="@+id/widget_day2_label" android:layout_width="78dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="" android:textColor="@color/widgetCardText" android:textSize="12sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/widget_day2_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/widgetCardTextMuted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_day3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
