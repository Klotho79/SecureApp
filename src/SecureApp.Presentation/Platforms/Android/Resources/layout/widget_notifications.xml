            </LinearLayout>
            <LinearLayout android:id="@+id/widget_duty7" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/widget_duty7_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/widgetCardText" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                <FrameLayout android:id="@+id/widget_duty7_phone_tap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="gone">
                    <ImageView android:id="@+id/widget_duty7_phone" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/widget_ic_phone" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_duty8" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
