<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 7 home-screen widget (2026-09-22, NOTIFICATION_HUB_SPEC.md §9). minWidth/minHeight sized
     for a 4x2 home-screen cell grid (rough Android convention: 70dp per cell minus margin) — big
     enough for the three pills + a 3-row card without feeling cramped, small enough to fit most
     launchers' grids without the user needing to resize it first. updatePeriodMillis is a periodic
     safety-net fallback only (Android clamps this to a 30-minute floor regardless of a smaller value);
     the real, fast-path updates come from NotificationsChangedSignal firing immediately on every
     notification create/read/archive — see NotificationsWidgetProvider's own remarks. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="150dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_notifications"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_notifications" />
