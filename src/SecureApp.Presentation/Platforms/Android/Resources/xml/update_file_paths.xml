<?xml version="1.0" encoding="utf-8"?>
<!-- Self-update (2026-09-23) — grants the FileProvider declared in AndroidManifest.xml access to
     the app's own cache directory, where NativeAppInstaller/UpdateService save the downloaded APK
     before handing it to the system package installer. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="apk_updates" path="." />
</paths>
